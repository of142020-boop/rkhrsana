---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";

/**
 * ✅ Homepage قوية (SEO + CRO) بنفس أسلوب صفحات الكور:
 * - Hero + WhatsApp Pricing Card
 * - Trust Bar + خدمات بشكل احترافي
 * - E-E-A-T + خطوات العمل
 * - معرض مشاريع + مناطق الخدمة
 * - FAQ + Schema (Organization/LocalBusiness/WebSite/WebPage/Breadcrumb/FAQ)
 */

const BRAND = "رواد الخرسانة";
const SITE_URL = "https://rkhrsana.com";
const PAGE_URL = `${SITE_URL}/`;
const LOGO_URL = `${SITE_URL}/logo.png`;

const PHONE = "01070046464";
const PHONE_INT = "+20" + PHONE.replace(/^0/, "");
const WHATSAPP = `https://wa.me/${PHONE_INT.replace("+", "")}`; // 201070046464

const TITLE = `رواد الخرسانة | قص وتخريم الخرسانة بالكور والمنشار والواير | اتصل ${PHONE}`;
const DESCRIPTION =
  `رواد الخرسانة: شركة متخصصة في قص وتخريم الخرسانة بالكور، القص بالمنشار، الواير الماسي، وتزريع الأشاير. تنفيذ نظيف ودقيق بدون تكسير عشوائي — اتصل الآن ${PHONE}.`;

// ====== FAQ (UI + Schema) ======
const faqItems = [
  {
    q: "ما الخدمات الأساسية التي تقدمها رواد الخرسانة؟",
    a: "نقدم: تخريم الخرسانة بالكور لعمل فتحات دقيقة، قص الخرسانة بالمنشار لعمل أبواب وشبابيك وفتحات سقف، قص الخرسانة بالواير للمشاريع الثقيلة والسمكات الضخمة، وتزريع الأشاير الكيميائي لربط الخرسانة القديمة بالجديدة."
  },
  {
    q: "هل الشغل آمن على الخرسانة المسلحة؟",
    a: "نعم عند التنفيذ الصحيح بالمعدات المناسبة وبفريق محترف. نحن نعتمد على تقنيات قص/تخريم تقلل الاهتزازات الصدمية مقارنة بالتكسير العشوائي، مع مراعاة تعليمات المهندس عند الحالات الحساسة."
  },
  {
    q: "كيف يتم تحديد السعر بسرعة؟",
    a: "السعر يتحدد حسب نوع الخدمة (كور/منشار/واير/تزريع)، المقاس أو عدد الفتحات/المتر الطولي، السمك وكثافة الحديد، وصعوبة الموقع. يمكنك إرسال بيانات بسيطة على واتساب للحصول على تقدير سريع."
  },
  {
    q: "هل يمكن التنفيذ داخل شقة متشطبة؟",
    a: "نعم. يتم تجهيز حماية وتغطية وتقليل غبار/مياه حسب ظروف المكان، والهدف تسليم نظيف بأقل فوضى ممكنة."
  },
  {
    q: "تخدموا أي مناطق؟",
    a: "نخدم الصعيد (المنيا وما حولها) ونغطي القاهرة والجيزة والمحافظات حسب حجم المشروع وطبيعة التنفيذ."
  },
  {
    q: "هل توفرون معاينة قبل التنفيذ؟",
    a: "متاح معاينة حسب نوع العمل وحجمه. اتصل بنا على 01070046464 لتحديد المطلوب بسرعة."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((x) => ({
    "@type": "Question",
    "name": x.q,
    "acceptedAnswer": { "@type": "Answer", "text": x.a }
  }))
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "رواد الخرسانة لقص وتخريم الخرسانة",
  "image": LOGO_URL,
  "telephone": PHONE,
  "url": SITE_URL,
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "EG"
  }
};

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "رواد الخرسانة لقص وتخريم الخرسانة",
  "url": SITE_URL,
  "logo": LOGO_URL,
  "telephone": PHONE,
  "sameAs": [
    "https://www.facebook.com/",
    "https://www.instagram.com/"
  ]
};

const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "rkhrsana",
  "url": SITE_URL
};

const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "الصفحة الرئيسية - رواد الخرسانة",
  "url": PAGE_URL,
  "isPartOf": { "@type": "WebSite", "name": "rkhrsana", "url": SITE_URL }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": PAGE_URL }]
};

// ====== WhatsApp quick message builder ======
const buildWhatsAppHomeMessage = (service, city, notes) => {
  const lines = [
    `مرحباً ${BRAND}`,
    `محتاج تسعير سريع لخدمة: ${service}`,
    `- المنطقة/المدينة: ${city}`,
    notes ? `- تفاصيل: ${notes}` : null,
    `اتصلوا بي على: ${PHONE}`
  ].filter(Boolean);

  return encodeURIComponent(lines.join("\n"));
};
---

<Layout title={TITLE} description={DESCRIPTION}>
  <link rel="canonical" href={PAGE_URL} />

  {/* ✅ Schema */}
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  {/* ========================================= */}
  {/* 1) HERO (نفس أسلوب الكور) */}
  {/* ========================================= */}
  <section class="relative bg-slate-900 text-white py-24 lg:py-32 overflow-hidden border-b-4 border-yellow-500">
    <div class="absolute inset-0 bg-slate-800 opacity-90"></div>
    <div class="absolute inset-0 bg-[url('https://placehold.co/1920x1080/0f172a/0f172a?text=Concrete+Experts')] bg-cover bg-center mix-blend-overlay opacity-25"></div>

    <div class="relative z-10 container mx-auto px-4 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 text-center md:text-right">
          <span class="inline-block bg-yellow-500 text-slate-900 font-bold px-4 py-1 rounded-full text-sm md:text-base mb-6 shadow-lg">
            الحل الهندسي النظيف والدقيق — بدون تكسير عشوائي
          </span>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold mb-6 leading-tight text-white drop-shadow-lg">
            الشركة المتخصصة في قص وتخريم الخرسانة بالكور والمنشار والواير
          </h1>

          <p class="text-lg md:text-2xl mb-8 text-slate-300 leading-relaxed font-light">
            في <strong class="text-white font-bold">{BRAND}</strong> بننفذ:
            <strong class="text-white"> تخريم كور</strong> لفتحات دقيقة،
            <strong class="text-white"> قص بالمنشار</strong> لفتحات الأبواب والشبابيك والسقف،
            <strong class="text-white"> قص بالواير</strong> للمشاريع الثقيلة،
            و<strong class="text-white"> تزريع أشاير</strong> لربط الخرسانة القديمة بالجديدة — بخطة أمان وتنفيذ منظم.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
            <a
              href={`tel:${PHONE}`}
              class="inline-flex items-center justify-center gap-3 bg-yellow-500 text-slate-900 px-8 py-4 rounded-lg text-xl font-bold hover:bg-yellow-400 hover:scale-105 transition-all shadow-xl shadow-yellow-500/20"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              اتصل الآن: <span dir="ltr">{PHONE}</span>
            </a>

            <a
              href="#services"
              class="inline-flex items-center justify-center gap-2 bg-transparent border-2 border-slate-600 text-white px-8 py-4 rounded-lg text-lg font-medium hover:border-yellow-500 hover:text-yellow-500 transition-colors"
            >
              استعرض الخدمات ↓
            </a>
          </div>

          {/* Trust bar */}
          <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-4 text-right">
            <div class="bg-white/5 border border-white/10 rounded-2xl p-5">
              <p class="text-yellow-400 font-black text-lg">دقة في المقاس</p>
              <p class="text-slate-200 text-sm leading-relaxed">تنفيذ مضبوط يقلل الترقيع والترميم بعد الشغل.</p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-2xl p-5">
              <p class="text-yellow-400 font-black text-lg">أمان إنشائي</p>
              <p class="text-slate-200 text-sm leading-relaxed">تقنيات قص/تخريم تقلل الاهتزازات الصدمية.</p>
            </div>
            <div class="bg-white/5 border border-white/10 rounded-2xl p-5">
              <p class="text-yellow-400 font-black text-lg">تسعير واضح</p>
              <p class="text-slate-200 text-sm leading-relaxed">نشرح عوامل التسعير قبل التنفيذ بدون مفاجآت.</p>
            </div>
          </div>

          <p class="mt-6 text-sm text-slate-400">
            نخدم المنيا ومحافظات الصعيد — ومتاح تنفيذ في القاهرة والجيزة حسب المشروع.
          </p>
        </div>

        {/* WhatsApp Pricing Card (CRO) */}
        <div class="lg:col-span-5">
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6 backdrop-blur-sm">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-xl font-bold text-white">تسعير فوري على واتساب</h2>
              <span class="text-xs bg-yellow-500 text-slate-900 px-3 py-1 rounded-full font-bold">سريع</span>
            </div>

            <ul class="space-y-3 text-slate-200 text-sm">
              <li class="flex gap-3 items-start"><span class="text-yellow-400 mt-1">✓</span><span>اختر الخدمة وابعث المنطقة وتفاصيل بسيطة.</span></li>
              <li class="flex gap-3 items-start"><span class="text-yellow-400 mt-1">✓</span><span>هنرد بتقدير سريع أو نحدد معاينة.</span></li>
              <li class="flex gap-3 items-start"><span class="text-yellow-400 mt-1">✓</span><span>متاح دمج خدمات (كور + منشار + واير) حسب الحالة.</span></li>
            </ul>

            <div class="mt-6 bg-white/5 border border-white/10 rounded-2xl p-4">
              <form
                class="space-y-3"
                onsubmit={`(function(e){
                  e.preventDefault();
                  const f = e.target;
                  const service = f.service.value || 'غير محدد';
                  const city = f.city.value || 'غير محدد';
                  const notes = f.notes.value || '';
                  const msg = ${buildWhatsAppHomeMessage.toString()}(service, city, notes);
                  window.open('${WHATSAPP}?text=' + msg, '_blank');
                })(event);`}
              >
                <div>
                  <label class="block text-xs font-bold text-slate-200 mb-1">الخدمة المطلوبة</label>
                  <select name="service" class="w-full border border-white/10 bg-slate-900/40 text-white rounded-xl px-4 py-3">
                    <option value="تخريم الخرسانة بالكور">تخريم الخرسانة بالكور</option>
                    <option value="قص الخرسانة بالمنشار">قص الخرسانة بالمنشار</option>
                    <option value="قص الخرسانة بالواير الماسي">قص الخرسانة بالواير الماسي</option>
                    <option value="تزريع الأشاير الكيميائي">تزريع الأشاير الكيميائي</option>
                    <option value="غير متأكد">غير متأكد</option>
                  </select>
                </div>

                <div>
                  <label class="block text-xs font-bold text-slate-200 mb-1">المنطقة/المدينة</label>
                  <input name="city" type="text" class="w-full border border-white/10 bg-slate-900/40 text-white rounded-xl px-4 py-3" placeholder="مثال: المنيا / بني سويف / القاهرة" />
                </div>

                <div>
                  <label class="block text-xs font-bold text-slate-200 mb-1">تفاصيل (اختياري)</label>
                  <textarea name="notes" rows="3" class="w-full border border-white/10 bg-slate-900/40 text-white rounded-xl px-4 py-3" placeholder="مثال: فتحة باب، سمك تقريبي، شقة متشطبة..."></textarea>
                </div>

                <button type="submit" class="w-full bg-yellow-500 text-slate-900 font-black py-3 rounded-xl hover:bg-yellow-400 transition-colors">
                  إرسال رسالة تسعير على واتساب
                </button>

                <p class="text-xs text-slate-300 text-right">
                  أو اتصل الآن: <a class="font-bold text-yellow-300 hover:underline" href={`tel:${PHONE}`}>{PHONE}</a>
                </p>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ========================================= */}
  {/* 2) Services (cards قوية) */}
  {/* ========================================= */}
  <section id="services" class="py-20 bg-white">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">خدماتنا الإنشائية المتخصصة</h2>
        <p class="text-slate-600 max-w-3xl mx-auto">
          اختر الخدمة المناسبة لمشكلتك — وكل خدمة لها صفحة تفصيلية (SEO قوي) بنفس أسلوب صفحات الكور.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { href: "/core-drilling", t: "تخريم الخرسانة بالكور", d: "فتحات دائرية دقيقة للسباكة والكهرباء والتكييف.", tag: "Core Drilling" },
          { href: "/saw-cutting", t: "قص الخرسانة بالمنشار", d: "فتح أبواب وشبابيك وقص سقف بحواف ناعمة.", tag: "Saw Cutting" },
          { href: "/wire-sawing", t: "قص الخرسانة بالواير", d: "للسمكات الضخمة والقواعد والخوازيق والمشاريع الثقيلة.", tag: "Diamond Wire" },
          { href: "/rebar-planting", t: "تزريع الأشاير", d: "زرع حديد كيميائي لربط القديم بالجديد بمادة إيبوكسي.", tag: "Rebar Planting" }
        ].map((x) => (
          <a href={x.href} class="group block p-6 bg-slate-50 border border-slate-200 rounded-2xl hover:border-yellow-500 hover:shadow-lg transition-all text-right">
            <span class="inline-block text-xs font-bold bg-white border border-slate-200 px-3 py-1 rounded-full mb-4 group-hover:border-yellow-500">
              {x.tag}
            </span>
            <h3 class="text-xl font-black text-slate-900 mb-2 group-hover:text-yellow-700">{x.t}</h3>
            <p class="text-slate-600 text-sm leading-relaxed">{x.d}</p>
            <div class="mt-4 text-sm font-bold text-slate-900 group-hover:text-yellow-700">
              افتح صفحة الخدمة →
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ========================================= */}
  {/* 3) E-E-A-T (لماذا نحن) */}
  {/* ========================================= */}
  <section class="py-16 bg-slate-50 border-t border-slate-200">
    <div class="container mx-auto px-4 lg:px-8 max-w-6xl">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">ليه تختار رواد الخرسانة؟</h2>
        <p class="text-slate-600 max-w-3xl mx-auto">
          لأننا بنقدم “نتيجة” مش مجرد شغل — دقة + أمان + تسليم نظيف يقلل الترميم.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl border border-slate-200 bg-white">
          <h3 class="text-xl font-bold text-slate-900 mb-2">منهجية تنفيذ</h3>
          <p class="text-slate-600 leading-relaxed">تحديد المسار/المقاس + حماية الموقع + تنفيذ منظم + تسليم واضح.</p>
        </div>
        <div class="p-6 rounded-2xl border border-slate-200 bg-white">
          <h3 class="text-xl font-bold text-slate-900 mb-2">معدات مناسبة للحالة</h3>
          <p class="text-slate-600 leading-relaxed">كور للفتحات الدقيقة، منشار للقص المستقيم، واير للسمكات الضخمة.</p>
        </div>
        <div class="p-6 rounded-2xl border border-slate-200 bg-white">
          <h3 class="text-xl font-bold text-slate-900 mb-2">تواصل وتسعير واضح</h3>
          <p class="text-slate-600 leading-relaxed">نشرح العوامل قبل التنفيذ ونساعدك تختار الأفضل بدون هدر.</p>
        </div>
      </div>

      <div class="mt-10 bg-slate-900 text-white rounded-2xl p-8 border-l-4 border-yellow-500">
        <p class="text-lg leading-relaxed">
          "لو محتاج شغل نظيف بدون تكسير عشوائي — اتصل على <strong class="text-yellow-400">{PHONE}</strong> وهنقولك الحل المناسب لحالتك."
        </p>
      </div>
    </div>
  </section>

  {/* ========================================= */}
  {/* 4) خطوات العمل (Process) */}
  {/* ========================================= */}
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4 lg:px-8 max-w-6xl">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">إزاي بنشتغل؟ (من أول اتصال لحد التسليم)</h2>
        <p class="text-slate-600 max-w-3xl mx-auto">
          خطوات ثابتة بتضمن جودة النتيجة وسلامة التنفيذ — سواء خدمة واحدة أو مشروع كبير.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 text-right">
        {[
          ["1", "تحديد المطلوب", "مكالمة/واتساب + صور + مقاسات تقريبية لتحديد الحل المناسب."],
          ["2", "تسعير واضح", "توضيح عوامل السعر وإعطاء تقدير سريع أو تحديد معاينة."],
          ["3", "تجهيز وحماية", "تغطية، تحديد مسار، تقليل غبار/مياه حسب المكان."],
          ["4", "تنفيذ وتسليم", "تنفيذ مضبوط + تنظيف + تسليم جاهز للمقاول التالي."]
        ].map((x) => (
          <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200 relative">
            <div class="absolute -top-4 -right-4 w-10 h-10 bg-yellow-500 text-slate-900 font-black rounded-full flex items-center justify-center">
              {x[0]}
            </div>
            <h3 class="text-xl font-black text-slate-900 mb-2 mt-2">{x[1]}</h3>
            <p class="text-slate-600 text-sm leading-relaxed">{x[2]}</p>
          </div>
        ))}
      </div>

      <div class="mt-10 text-center">
        <a href={`tel:${PHONE}`} class="inline-flex items-center justify-center gap-3 bg-yellow-500 text-slate-900 px-8 py-4 rounded-xl text-xl font-black hover:bg-yellow-400 transition-colors shadow-lg">
          اتصل الآن: <span dir="ltr">{PHONE}</span>
        </a>
      </div>
    </div>
  </section>

  {/* ========================================= */}
  {/* 5) Gallery */}
  {/* ========================================= */}
  <section class="py-20 bg-slate-50 border-t border-slate-200">
    <div class="container mx-auto px-4 lg:px-8 max-w-6xl">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-5">صور من أعمالنا</h2>
        <p class="text-slate-600 max-w-3xl mx-auto">
          استبدل الصور التوضيحية بصور شغلك الحقيقي (قبل/بعد) — ده أقوى عنصر ثقة في الصفحة الرئيسية.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          "Core Drilling",
          "Saw Cutting",
          "Diamond Wire Saw",
          "Rebar Planting",
          "Ceiling / Slab Work",
          "Industrial Projects"
        ].map((t) => (
          <figure class="bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
            <img
              src={`https://placehold.co/900x650/0f172a/f59e0b?text=${encodeURIComponent(t)}`}
              alt={`مشروع ${t}`}
              loading="lazy"
              class="w-full h-56 object-cover"
            />
            <figcaption class="p-4 text-right">
              <p class="font-bold text-slate-900">{t}</p>
              <p class="text-sm text-slate-600 mt-1">تنفيذ منظم + نتيجة نظيفة.</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  {/* ========================================= */}
  {/* 6) مناطق الخدمة */}
  {/* ========================================= */}
  <section class="py-20 bg-white border-t border-slate-200">
    <div class="container mx-auto px-4 lg:px-8 max-w-6xl">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-5">بنخدم فين؟</h2>
        <p class="text-slate-600 max-w-3xl mx-auto">
          خدمة داخل الصعيد (المنيا وما حولها) — ومتاح تنفيذ خارجها حسب حجم المشروع.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 text-right">
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6">
          <p class="font-black text-slate-900 mb-3">المنيا والصعيد</p>
          <p class="text-slate-700 text-sm leading-relaxed">
            المنيا، بني سويف، أسيوط، سوهاج، قنا — ومناطق قريبة حسب المشروع.
          </p>
        </div>
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6">
          <p class="font-black text-slate-900 mb-3">القاهرة الكبرى</p>
          <p class="text-slate-700 text-sm leading-relaxed">
            القاهرة، الجيزة — تنفيذ حسب نوع الشغل والتجهيزات المطلوبة.
          </p>
        </div>
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6">
          <p class="font-black text-slate-900 mb-3">محافظات حسب العمل</p>
          <p class="text-slate-700 text-sm leading-relaxed">
            تنفيذ للمشاريع والمقاولات الكبرى خارج النطاق عند توفر مشروع مناسب.
          </p>
        </div>
      </div>

      <div class="mt-10 text-center">
        <a href={`tel:${PHONE}`} class="inline-flex items-center justify-center gap-3 bg-slate-900 text-yellow-500 px-8 py-4 rounded-2xl text-xl font-black hover:bg-slate-800 transition-colors shadow-lg">
          تواصل الآن: <span dir="ltr">{PHONE}</span>
        </a>
      </div>
    </div>
  </section>

  {/* ========================================= */}
  {/* 7) FAQ UI */}
  {/* ========================================= */}
  <section class="py-20 bg-slate-900 text-white border-t-4 border-yellow-500">
    <div class="container mx-auto px-4 lg:px-8 max-w-5xl">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-yellow-500 mb-6">أسئلة شائعة (FAQ)</h2>
        <p class="text-slate-300">إجابات سريعة تساعدك تفهم وتقرر.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 text-right">
        {faqItems.map((item) => (
          <div class="bg-slate-800 p-6 rounded-xl border border-slate-700">
            <h3 class="font-bold text-yellow-400 mb-3 text-lg">{item.q}</h3>
            <p class="text-slate-300 text-sm leading-relaxed">{item.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ========================================= */}
  {/* 8) Final CTA */}
  {/* ========================================= */}
  <section class="py-20 bg-yellow-500 text-slate-900 text-center relative overflow-hidden">
    <div class="absolute inset-0 opacity-10 pointer-events-none bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-slate-900 to-transparent"></div>

    <div class="container mx-auto px-4 lg:px-8 max-w-4xl relative z-10">
      <h2 class="text-4xl md:text-5xl font-black mb-8 leading-tight">جاهز تبدأ شغلك بأمان وبدون تكسير عشوائي؟</h2>

      <p class="text-xl md:text-2xl mb-10 font-bold">
        اتصل الآن بـ <span class="bg-white/50 px-2 rounded">{BRAND}</span> وخد تسعير سريع أو حدّد معاينة.
      </p>

      <div class="flex flex-col sm:flex-row gap-6 justify-center items-center">
        <a
          href={`tel:${PHONE}`}
          class="flex items-center justify-center gap-4 bg-slate-900 text-yellow-500 px-10 py-5 rounded-2xl text-3xl font-black hover:bg-slate-800 hover:scale-105 transition-all shadow-2xl w-full sm:w-auto"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span dir="ltr">{PHONE}</span>
        </a>

        <a
          href={`${WHATSAPP}?text=${encodeURIComponent(`مرحباً ${BRAND}، محتاج تسعير سريع/معاينة. اتصلوا بي على ${PHONE}`)}`}
          target="_blank"
          rel="noopener"
          class="flex items-center justify-center gap-3 bg-[#25D366] text-white px-10 py-5 rounded-2xl text-2xl font-black hover:bg-green-600 transition-colors shadow-2xl w-full sm:w-auto"
        >
          واتساب مباشر
        </a>
      </div>

      <p class="mt-6 text-sm font-bold text-slate-800">
        خدمات: كور · منشار · واير · تزريع أشاير — داخل مصر حسب المشروع.
      </p>
    </div>
  </section>
</Layout>
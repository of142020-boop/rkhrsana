---
// src/pages/about.astro
import Layout from "../layouts/Layout.astro";

/**
 * صفحة "من نحن" (About Us)
 * - تحتوي على نبذة عن شركة رواد الخرسانة وخبراتنا ورؤيتنا.
 * - Schema مخصص: AboutPage
 */

// ====== بيانات أساسية ======
const BRAND = "رواد الخرسانة";
const SITE_URL = "https://rkhrsana.com";
const PAGE_URL = `${SITE_URL}/about`;
const LOGO_URL = `${SITE_URL}/images/og-default.webp`;

// ====== SEO ======
const PAGE_TITLE = `من نحن | شركة رواد الخرسانة لقص وتخريم الخرسانة المسلحة`;
const PAGE_DESCRIPTION = `تعرف على شركة رواد الخرسانة، الرائدة في أعمال قص وتخريم الخرسانة بالكور والمنشار والواير، وتزريع الأشاير الكيميائية بأفضل المعدات الألمانية وبخبرات هندسية رائدة.`;

// ====== Schema ======
const aboutPageSchema = {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    name: "عن رواد الخرسانة",
    description: PAGE_DESCRIPTION,
    url: PAGE_URL,
    mainEntity: {
        "@type": "Organization",
        name: BRAND,
        description:
            "شركة متخصصة في أعمال تخريم وقص الخرسانة وتزريع الأشاير على مستوى جمهورية مصر العربية.",
        url: SITE_URL,
        logo: LOGO_URL,
    },
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "الرئيسية",
            item: SITE_URL,
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "من نحن",
            item: PAGE_URL,
        },
    ],
};

// JSON-LD Combined
const jsonLd = JSON.stringify([aboutPageSchema, breadcrumbSchema]);
---

<Layout
    title={PAGE_TITLE}
    description={PAGE_DESCRIPTION}
    url={PAGE_URL}
    image={LOGO_URL}
>
    <Fragment slot="head">
        <script type="application/ld+json" set:html={jsonLd} is:inline></script>
        <!-- Preload Hero Image -->
        <link rel="preload" href="/images/contact-hero.webp" as="image" />
    </Fragment>

    <main class="w-full flex flex-col bg-slate-50 min-h-screen">
        {/* ================= HERO SECTION ================= */}
        <section
            class="relative w-full h-[50vh] flex items-center justify-center overflow-hidden bg-slate-900 border-b-4 border-amber-500"
        >
            <div
                class="absolute inset-0 bg-[url('/images/contact-hero.webp')] bg-cover bg-center mix-blend-overlay opacity-25"
            >
            </div>
            <div
                class="relative z-10text-center px-4 max-w-4xl mx-auto flex flex-col items-center"
            >
                <h1
                    class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white mb-6 drop-shadow-md text-center leading-tight"
                >
                    من نحن - <span class="text-amber-500">رواد الخرسانة</span>
                </h1>
                <p
                    class="text-lg md:text-xl text-slate-200 max-w-2xl text-center font-medium leading-relaxed drop-shadow"
                >
                    شركة رائدة في مجال أعمال قص وتخريم الخرسانة باستخدام أحدث
                    المعدات التكنولوجية المتطورة للالتزام بأعلى معايير الجودة
                    والأمان.
                </p>
            </div>
        </section>

        {/* ================= ABOUT CONTENT ================= */}
        <section class="w-full py-20 px-4">
            <div class="max-w-5xl mx-auto space-y-16">
                {/* Intro */}
                <div
                    class="bg-white p-8 md:p-12 rounded-3xl shadow-sm border border-slate-100 flex flex-col md:flex-row gap-8 items-center"
                >
                    <div class="w-full md:w-1/2 flex justify-center">
                        <img
                            src="/images/wire-sawing-hero.webp"
                            alt="شركة رواد الخرسانة في موقع العمل"
                            class="rounded-2xl shadow-md w-full h-auto object-cover max-h-80"
                            loading="lazy"
                        />
                    </div>
                    <div class="w-full md:w-1/2">
                        <h2
                            class="text-3xl font-bold text-slate-800 mb-6 flex items-center gap-3"
                        >
                            <span
                                class="w-2 h-8 bg-amber-500 rounded-full inline-block"
                            ></span>
                            رؤيتنا ورسالتنا
                        </h2>
                        <p class="text-slate-600 leading-loose text-lg mb-4">
                            نحن في <span class="font-bold text-slate-800"
                                >رواد الخرسانة</span
                            > نؤمن بأن الدقة والاحترافية هما حجر الأساس لأي مشروع
                            هندسي ناجح. لذلك، نسعى دائماً لتقديم خدمات وحلول متكاملة
                            وعالية الكفاءة في مجال التعديل الإنشائي.
                        </p>
                        <p class="text-slate-600 leading-loose text-lg">
                            رؤيتنا هي أن نظل الاختيار الأول والأكثر موثوقية
                            لعملائنا في كافة محافظات جمهورية مصر العربية، من
                            خلال الالتزام بمواعيد التسليم الصارمة واستخدام أحدث
                            التكنولوجيا الألمانية في القطع الـماسي.
                        </p>
                    </div>
                </div>

                {/* Why Choose Us */}
                <div>
                    <h2
                        class="text-3xl font-bold text-slate-800 mb-10 text-center"
                    >
                        لماذا تختار رواد الخرسانة؟
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                        <div
                            class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100 text-center hover:shadow-md transition-shadow"
                        >
                            <div
                                class="w-16 h-16 bg-amber-100 text-amber-600 rounded-2xl flex items-center justify-center mx-auto mb-6"
                            >
                                <svg
                                    class="w-8 h-8"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    ><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                                </svg>
                            </div>
                            <h3 class="text-xl font-bold text-slate-800 mb-3">
                                سرعة الإنجاز
                            </h3>
                            <p class="text-slate-600 leading-relaxed">
                                ندرك قيمة الوقت في المشاريع الإنشائية، لذلك نوفر
                                فريق عمل جاهز للانطلاق وإنجاز المهام بأسرع وقت
                                دون التأثير على جودة العمل.
                            </p>
                        </div>
                        <div
                            class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100 text-center hover:shadow-md transition-shadow"
                        >
                            <div
                                class="w-16 h-16 bg-blue-100 text-blue-600 rounded-2xl flex items-center justify-center mx-auto mb-6"
                            >
                                <svg
                                    class="w-8 h-8"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    ><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                                    ></path>
                                </svg>
                            </div>
                            <h3 class="text-xl font-bold text-slate-800 mb-3">
                                الأمان والاحترافية
                            </h3>
                            <p class="text-slate-600 leading-relaxed">
                                نعمل بدون إحداث أي اهتزازات أو شروخ في أساسات
                                المباني (Non-Vibration & Non-Destructive) للحفاظ
                                على السلامة الإنشائية للهيكل.
                            </p>
                        </div>
                        <div
                            class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100 text-center hover:shadow-md transition-shadow"
                        >
                            <div
                                class="w-16 h-16 bg-green-100 text-green-600 rounded-2xl flex items-center justify-center mx-auto mb-6"
                            >
                                <svg
                                    class="w-8 h-8"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    ><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                                    ></path>
                                </svg>
                            </div>
                            <h3 class="text-xl font-bold text-slate-800 mb-3">
                                أحدث المعدات الألمانية
                            </h3>
                            <p class="text-slate-600 leading-relaxed">
                                نمتلك أسطولاً من ماكينات الكور دريل، والمناشير
                                الجدارية الماسية، والمناشير السلكية (الواير) من
                                كبرى الشركات العالمية مثل Hilti لضمان الأداء
                                الفائق.
                            </p>
                        </div>
                    </div>
                </div>

                {/* CTA */}
                <div
                    class="bg-slate-900 rounded-3xl p-10 mt-16 text-center text-white border-b-4 border-amber-500 shadow-xl relative overflow-hidden"
                >
                    <div
                        class="absolute inset-0 bg-[url('/images/hero-bg.webp')] opacity-10 bg-cover bg-center"
                    >
                    </div>
                    <div class="relative z-10">
                        <h3 class="text-3xl font-bold mb-4">
                            هل لديك مشروع وتحتاج مقايسة فنية؟
                        </h3>
                        <p
                            class="text-slate-300 mb-8 max-w-2xl mx-auto text-lg"
                        >
                            يسعدنا التواصل معك وتقديم استشارات هندسية وحلول
                            تقنية تناسب متطلبات مشروعك.
                        </p>
                        <a
                            href="/contact/"
                            class="inline-flex items-center gap-2 bg-amber-500 hover:bg-amber-600 text-slate-900 font-bold py-3 px-8 rounded-full shadow-lg transition-all focus:ring-4 focus:ring-amber-500/30"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                                ></path>
                            </svg>
                            تواصل معنا الآن
                        </a>
                    </div>
                </div>
            </div>
        </section>
    </main>
</Layout>

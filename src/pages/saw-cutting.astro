      <div class="bg-white p-8 rounded-2xl shadow-lg border border-slate-100">
        <div class="grid md:grid-cols-2 gap-8">
          <ul class="space-y-4">
            {[
              ["السمك", "كل ما زاد السمك زاد وقت القص واستهلاك الشفرات."],

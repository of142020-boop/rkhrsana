---
// src/pages/saw-cutting.astro
import Layout from "../layouts/Layout.astro";

/**
 * ✅ صفحة "قص الخرسانة بالمنشار" بتصميم صفحة الكور (مطابقة في الهيكل والشكل)
 * - Schema قوي: FAQ + LocalBusiness + Organization + Service + WebPage + Breadcrumb
 * - FAQ موحّد (UI + Schema)
 * - جدول تنقل سريع + IDs للأقسام (services/equipment/pricing/gallery/faq)
 * - E-E-A-T
 * - Gallery
 * - نموذج تسعير سريع يفتح واتساب برسالة جاهزة
 */

// ====== بيانات أساسية ======
const BRAND = "رواد الخرسانة";
const PHONE = "01070046464";
const PHONE_INT = "+20" + PHONE.replace(/^0/, "");
const WHATSAPP = `https://wa.me/${PHONE_INT.replace("+", "")}`; // ✅ 201070046464
const SITE_URL = "https://rkhrsana.com";
const PAGE_URL = `${SITE_URL}/saw-cutting`;
const LOGO_URL = `${SITE_URL}/logo.png`;

// ====== SEO ======
const TITLE = `قص خرسانة ليزر | قص الخرسانة بالمنشار الماسي بدون تكسير | اتصل الآن ${PHONE}`;
const DESCRIPTION =
  `خدمة قص خرسانة ليزر (قص دقيق) باستخدام منشار قص الخرسانة الماسي لقص الجدران والأسقف والأرضيات وفتح الأبواب والشبابيك وفواصل التمدد بأمان وبدون اهتزازات صدمية. اتصل الآن ${PHONE}.`;

// ====== FAQ موحّد: يظهر في الصفحة + Schema ======
const faqItems = [
  {
    q: "ما هو الفرق بين قص الخرسانة بالليزر والمنشار العادي؟",
    a: "مصطلح قص خرسانة ليزر يُستخدم في السوق لوصف الدقة والنظافة التي يحققها منشار قص الخرسانة الماسي. المنشار الماسي يعطي حواف مستقيمة وناعمة بدون تكسير عشوائي مقارنة بالطرق التقليدية."
  },
  {
    q: "كيف يتم تحديد اسعار قص الخرسانة؟",
    a: "اسعار قص الخرسانة تتحدد حسب: السمك، طول مسار القطع بالمتر الطولي، كثافة التسليح (الحديد)، نوع العمل (جدار/سقف/أرضيات)، صعوبة الموقع (ارتفاع/سقالات/ضيق)، وخدمة نقل المخلفات إن وُجدت. للتسعير السريع اتصل على 01070046464."
  },
  {
    q: "هل قص خرسانة السقف يؤثر على سلامة المبنى؟",
    a: "عند التنفيذ بواسطة مقاول قص خرسانة محترف وبعد مراجعة مواضع العناصر الإنشائية مع المهندس، فإن منشار تقطيع الخرسانة يقلل الاهتزازات الصدمية مقارنة بالتكسير، ما يجعله أكثر أماناً."
  },
  {
    q: "متى يتم استخدام صاروخ قص الخرسانة بدل المنشار الجداري؟",
    a: "يُستخدم صاروخ قص الخرسانة في المساحات الضيقة والتعديلات الصغيرة والأعماق المتوسطة، بينما المنشار الجداري/الأرضي يُفضّل للمسارات الطويلة والقص المستقيم والأعماق الأكبر وفتحات الأبواب والشبابيك."
  },
  {
    q: "هل يمكن قص جدار بالمنشار لعمل باب دون إخلاء المنزل؟",
    a: "نعم، مع تجهيز حماية للمكان وتغطية للأثاث وتقليل الغبار باستخدام تبريد بالمياه وتجميع/شفط حسب ظروف الموقع. يُنصح بإبعاد الأشياء الحساسة القريبة فقط."
  },
  {
    q: "هل تقدمون إزالة الكتل الخرسانية بعد القص؟",
    a: "نعم كخدمة إضافية حسب الاتفاق: تقطيع الكتلة لأجزاء مناسبة ثم تحميلها ونقلها والتخلص منها."
  },
  {
    q: "كم يستغرق قص فتحة باب أو شباك في حائط خرسانة؟",
    a: "المدة تعتمد على السمك والتسليح وطول المسار وتجهيز المكان. كثير من الفتحات القياسية يمكن إنهاؤها خلال ساعات قليلة بعد تجهيز الحماية وتحديد المسار."
  },
  {
    q: "هل يوجد ضوضاء أو تكسير أثناء قص الخرسانة؟",
    a: "يوجد صوت تشغيل طبيعي للمعدة، لكن بدون موجات صدمية مثل الدقاق. والقص أقل تكسيراً بكثير من الطرق التقليدية، مع تقليل الغبار بواسطة المياه/الشفط."
  }
];

// ====== Schema: FAQPage ======
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((x) => ({
    "@type": "Question",
    "name": x.q,
    "acceptedAnswer": { "@type": "Answer", "text": x.a }
  }))
};

// ====== Schema: LocalBusiness ======
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "رواد الخرسانة لقص وتخريم الخرسانة",
  "image": LOGO_URL,
  "telephone": PHONE,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "الحي العاشر",
    "addressLocality": "مدينة نصر",
    "addressRegion": "القاهرة",
    "addressCountry": "EG"
  },
  "url": PAGE_URL,
  "priceRange": "$$"
};

// ====== Schema: Organization ======
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "رواد الخرسانة لقص وتخريم الخرسانة",
  "url": SITE_URL,
  "logo": LOGO_URL,
  "telephone": PHONE,
  "sameAs": [
    "https://www.facebook.com/",
    "https://www.instagram.com/"
  ]
};

// ====== Schema: Service ======
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "قص الخرسانة بالمنشار الماسي (Wall & Floor Saw)",
  "serviceType": "Concrete Saw Cutting",
  "provider": {
    "@type": "LocalBusiness",
    "name": "رواد الخرسانة لقص وتخريم الخرسانة",
    "telephone": PHONE,
    "url": PAGE_URL
  },
  "areaServed": [
    { "@type": "AdministrativeArea", "name": "القاهرة" },
    { "@type": "AdministrativeArea", "name": "الجيزة" },
    { "@type": "AdministrativeArea", "name": "القليوبية" }
  ],
  "url": PAGE_URL,
  "description": DESCRIPTION
};

// ====== Schema: WebPage ======
const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "قص خرسانة ليزر وقص الخرسانة بالمنشار الماسي",
  "url": PAGE_URL,
  "isPartOf": { "@type": "WebSite", "name": "rkhrsana", "url": SITE_URL }
};

// ====== Schema: Breadcrumb ======
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": `${SITE_URL}/` },
    { "@type": "ListItem", "position": 2, "name": "قص الخرسانة بالمنشار", "item": PAGE_URL }
  ]
};

// ====== رسالة واتساب جاهزة (تتكون من الفورم في الأسفل) ======
const buildWhatsAppMessage = (workType, thickness, meters, city, notes) => {
  const lines = [
    `مرحباً ${BRAND}`,
    `محتاج تسعير سريع لـ قص خرسانة ليزر / قص بالمنشار الماسي.`,
    `- نوع الشغل: ${workType}`,
    `- سمك الخرسانة: ${thickness}`,
    `- طول مسار القص (متر طولي): ${meters}`,
    `- المنطقة/المدينة: ${city}`,
    notes ? `- ملاحظات: ${notes}` : null,
    `رقمي للتواصل: ${PHONE}`
  ].filter(Boolean);

  return encodeURIComponent(lines.join("\n"));
};
---

<Layout title={TITLE} description={DESCRIPTION}>
  {/* ✅ Canonical */}
  <link rel="canonical" href={PAGE_URL} />

  {/* ✅ Schema JSON-LD */}
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  {/* ========================================= */}
  {/* 1) Hero Section (نفس الكور) */}
  {/* ========================================= */}
  <section class="relative bg-slate-900 text-white py-24 lg:py-32 overflow-hidden border-b-4 border-yellow-500">
    <div class="absolute inset-0 bg-slate-800 opacity-90"></div>
    <div class="absolute inset-0 bg-[url('https://placehold.co/1920x1080/0f172a/0f172a?text=Concrete+Saw+Cutting')] bg-cover bg-center mix-blend-overlay opacity-25"></div>

    <div class="relative z-10 container mx-auto px-4 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 text-center md:text-right">
          <span class="inline-block bg-yellow-500 text-slate-900 font-bold px-4 py-1 rounded-full text-sm md:text-base mb-6 shadow-lg">
            قص دقيق “قص خرسانة ليزر” بحواف ناعمة
          </span>

          <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold mb-6 leading-tight text-white drop-shadow-lg">
            قص خرسانة وتقطيع الخرسانة المسلحة بالمنشار الماسي بدون تكسير
          </h1>

          <p class="text-lg md:text-2xl mb-8 text-slate-300 leading-relaxed font-light">
            لو محتاج <strong class="text-white font-bold">قص جدار بالمنشار</strong> لعمل باب/شباك،
            أو <strong class="text-white font-bold">قص خرسانة السقف</strong> لفتحة سلم/مصعد،
            أو فواصل تمدد للأرضيات… خدمة{" "}
            <strong class="text-white font-bold">منشار قص الخرسانة</strong>{" "}
            هي الحل الأنظف والأكثر أماناً من التكسير العشوائي.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
            <a
              href={`tel:${PHONE}`}
              class="inline-flex items-center justify-center gap-3 bg-yellow-500 text-slate-900 px-8 py-4 rounded-lg text-xl font-bold hover:bg-yellow-400 hover:scale-105 transition-all shadow-xl shadow-yellow-500/20"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                />
              </svg>
              احجز معاينة: {PHONE}
            </a>

            <a
              href="#comprehensive-guide"
              class="inline-flex items-center justify-center gap-2 bg-transparent border-2 border-slate-600 text-white px-8 py-4 rounded-lg text-lg font-medium hover:border-yellow-500 hover:text-yellow-500 transition-colors"
            >
              اقرأ الدليل الشامل للخدمة ↓
            </a>
          </div>

          <p class="mt-6 text-sm text-slate-400">
            نغطي القاهرة والجيزة والمحافظات حسب حجم المشروع.
          </p>
        </div>

        {/* بطاقة سريعة (CRO) - نفس الكور */}
        <div class="lg:col-span-5">
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6 backdrop-blur-sm">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-xl font-bold text-white">تسعير فوري على واتساب</h2>
              <span class="text-xs bg-yellow-500 text-slate-900 px-3 py-1 rounded-full font-bold">سريع</span>
            </div>

            <ul class="space-y-3 text-slate-200 text-sm">
              <li class="flex gap-3 items-start">
                <span class="text-yellow-400 mt-1">✓</span>
                <span>حدد نوع الشغل (جدار/سقف/أرضيات) + المقاس + السمك.</span>
              </li>
              <li class="flex gap-3 items-start">
                <span class="text-yellow-400 mt-1">✓</span>
                <span>قص مستقيم بحواف ناعمة يقلل الترميم بعد التنفيذ.</span>
              </li>
              <li class="flex gap-3 items-start">
                <span class="text-yellow-400 mt-1">✓</span>
                <span>بدون اهتزازات صدمية مثل الدقاق/الجاك هامر.</span>
              </li>
            </ul>

            <a
              href={`${WHATSAPP}?text=${encodeURIComponent(
                `مرحباً ${BRAND}، محتاج تسعير لـ قص خرسانة ليزر / قص بالمنشار الماسي. اتصلوا بي على ${PHONE}`
              )}`}
              target="_blank"
              rel="noopener"
              class="mt-6 inline-flex w-full items-center justify-center gap-2 bg-[#25D366] text-white px-6 py-3 rounded-xl font-bold hover:bg-green-600 transition-colors shadow-lg"
            >
              راسلنا على واتساب الآن
            </a>

            <div class="mt-4 text-xs text-slate-300">
              أو اتصل مباشرة:{" "}
              <a class="font-bold text-yellow-300 hover:underline" href={`tel:${PHONE}`}>
                {PHONE}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ========================================= */}
  {/* 2) مقدمة + جدول تنقل سريع (نفس الكور) */}
  {/* ========================================= */}
  <section id="comprehensive-guide" class="py-16 bg-white">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="max-w-5xl mx-auto text-right">
        {/* جدول تنقل */}
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 mb-10">
          <div class="flex flex-wrap gap-3 justify-end">
            <a href="#services" class="px-4 py-2 rounded-lg bg-white border border-slate-200 hover:border-yellow-500">
              الخدمات
            </a>
            <a href="#equipment" class="px-4 py-2 rounded-lg bg-white border border-slate-200 hover:border-yellow-500">
              المعدات
            </a>
            <a href="#pricing" class="px-4 py-2 rounded-lg bg-white border border-slate-200 hover:border-yellow-500">
              الأسعار
            </a>
            <a href="#gallery" class="px-4 py-2 rounded-lg bg-white border border-slate-200 hover:border-yellow-500">
              مشاريعنا
            </a>
            <a href="#faq" class="px-4 py-2 rounded-lg bg-white border border-slate-200 hover:border-yellow-500">
              الأسئلة الشائعة
            </a>
            <a href={`tel:${PHONE}`} class="px-4 py-2 rounded-lg bg-yellow-500 font-bold text-slate-900">
              اتصال سريع
            </a>
          </div>
        </div>

        <div class="prose prose-lg prose-slate max-w-none">
          <h2 class="text-3xl font-bold text-slate-900 mb-6">
            الدليل الشامل: ما هو قص الخرسانة بالمنشار ولماذا هو بديل التكسير؟
          </h2>

          <p class="text-slate-700 leading-loose mb-6">
            في التجديدات والمشاريع الحديثة، تحتاج أحيانًا لفتحة باب جديدة، توسعة شباك، فتحة سلم/مصعد، أو فواصل تمدد
            للأرضيات. المشكلة أن التكسير العشوائي يسبب فوضى واهتزازات وترميمات كبيرة.
          </p>

          <p class="text-slate-700 leading-loose mb-6">
            هنا يأتي دور <strong class="text-yellow-600">قص خرسانة ليزر</strong> — وهو وصف شائع لنتيجة القص الماسي الدقيقة.
            عمليًا يتم التنفيذ باستخدام <strong class="text-slate-900">منشار قص الخرسانة</strong> بشفرات ألماسية تقطع
            الخرسانة والحديد بكفاءة، لتسليم حواف مستقيمة وناعمة.
          </p>

          <p class="text-slate-700 leading-loose">
            نحن في "{BRAND}" ننفذ القص بخطة واضحة: تحديد المسار بالمقاس، حماية المكان، تشغيل منظم، وتسليم نظيف يقلل
            أعمال الترميم بعد التنفيذ.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ========================================= */}
  {/* 3) لماذا المنشار أفضل؟ (نفس ستايل الكور) */}
  {/* ========================================= */}
  <section class="py-20 bg-slate-50 border-t border-slate-200">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">
          لماذا قص الخرسانة بالمنشار أفضل من التكسير أو التخريم العشوائي؟
        </h2>
        <div class="w-24 h-1 bg-yellow-500 mx-auto rounded-full mb-6"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-6xl mx-auto">
        {[
          {
            n: "1",
            t: "قص مستقيم بحواف ناعمة",
            p: "النتيجة نظيفة وتقلل المحارة والترميم بعد التنفيذ، وتسهّل تركيب الإطارات للأبواب والشبابيك."
          },
          {
            n: "2",
            t: "اهتزاز أقل = أمان أعلى",
            p: "المنشار يقطع بدل ما يكسّر، لذلك يقلل الاهتزازات الصدمية ويحمي العناصر المجاورة والتشطيبات."
          },
          {
            n: "3",
            t: "كفاءة في الخرسانة المسلحة",
            p: "الشفرات الألماسية تقطع الخرسانة والحديد معًا بكفاءة، ومناسبة للسمكات المختلفة."
          },
          {
            n: "4",
            t: "سرعة تنفيذ وتكلفة نهائية أقل",
            p: "قص منظم يقلل وقت العمل والترميمات والمخلفات مقارنة بالتكسير العشوائي."
          }
        ].map((x) => (
          <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100 flex flex-col md:flex-row gap-6 hover:shadow-md transition-shadow">
            <div class="w-16 h-16 shrink-0 bg-slate-900 text-yellow-500 rounded-2xl flex items-center justify-center text-3xl font-black">
              {x.n}
            </div>
            <div>
              <h3 class="text-2xl font-bold text-slate-800 mb-3">{x.t}</h3>
              <p class="text-slate-600 leading-relaxed">{x.p}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ========================================= */}
  {/* 4) خدماتنا الأساسية (ID: services) - نفس الكور */}
  {/* ========================================= */}
  <section id="services" class="py-20 bg-white">
    <div class="container mx-auto px-4 lg:px-8 max-w-6xl">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-5xl font-bold text-slate-900 mb-6">خدماتنا الأساسية في قص وتقطيع الخرسانة</h2>
        <p class="text-lg text-slate-600 max-w-3xl mx-auto">
          نقدم في "{BRAND}" كل أعمال <strong>تقطيع الخرسانة</strong> بالمنشار الماسي للمشاريع والسكني بدقة واحتراف.
        </p>
      </div>

      <div class="space-y-12">
        <div class="flex flex-col md:flex-row gap-8 items-center bg-slate-50 rounded-2xl overflow-hidden border border-slate-100">
          <div class="w-full md:w-1/3 h-64 bg-slate-200 relative">
            <img
              src="https://placehold.co/900x600/0f172a/f59e0b?text=Wall+Saw+Door+Window"
              alt="قص جدار بالمنشار لعمل أبواب وشبابيك"
              class="object-cover w-full h-full"
              loading="lazy"
            />
          </div>
          <div class="w-full md:w-2/3 p-6 md:p-8 text-right">
            <h3 class="text-2xl font-bold text-slate-900 mb-4">قص جدار بالمنشار لعمل أبواب وشبابيك</h3>
            <ul class="space-y-2 text-slate-700 list-disc list-inside mb-4">
              <li>فتح باب جديد أو توسعة فتحة قائمة.</li>
              <li>فتح شباك أو تعديل فتحة واجهة.</li>

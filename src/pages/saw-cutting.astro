              <li class="flex gap-4 items-start">
                <span class="w-6 h-6 rounded-full bg-yellow-100 text-yellow-600 flex items-center justify-center shrink-0 mt-1">✔</span>
                <div>
                  <strong class="block text-slate-900 text-lg mb-1">{t}:</strong>
                  <span class="text-slate-600 text-sm">{d}</span>
                </div>
              </li>
            ))}
          </ul>

          <ul class="space-y-4">
            {[
              ["نوع العمل", "جدار/سقف/أرضيات/فواصل — كل نوع له تجهيز مختلف."],
              ["صعوبة الوصول", "ارتفاعات/سقالات/ضيق المكان تؤثر على التجهيز والزمن."],
              ["نقل المخلفات", "اختياري حسب الاتفاق وحجم الكتل."]
            ].map(([t, d]) => (
              <li class="flex gap-4 items-start">
                <span class="w-6 h-6 rounded-full bg-yellow-100 text-yellow-600 flex items-center justify-center shrink-0 mt-1">✔</span>
                <div>
                  <strong class="block text-slate-900 text-lg mb-1">{t}:</strong>
                  <span class="text-slate-600 text-sm">{d}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>

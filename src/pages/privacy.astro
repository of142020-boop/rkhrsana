---
// src/pages/privacy.astro
import Layout from "../layouts/Layout.astro";

/**
 * صفحة "سياسة الخصوصية" (Privacy Policy)
 * - توضح سياسة التعامل مع بيانات المستخدم التي يتم إدخالها في صفحة اتصل بنا.
 */

// ====== بيانات أساسية ======
const BRAND = "رواد الخرسانة";
const SITE_URL = "https://rkhrsana.com";
const PAGE_URL = `${SITE_URL}/privacy`;
const LOGO_URL = `${SITE_URL}/images/og-default.webp`;

// ====== SEO ======
const PAGE_TITLE = `سياسة الخصوصية | رواد الخرسانة`;
const PAGE_DESCRIPTION = `اقرأ سياسة الخصوصية الخاصة لشركة رواد الخرسانة وتعرف على كيفية جمع وحماية بيانات عملائنا وسريتها التامة.`;

// ====== Schema ======
const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "الرئيسية",
            item: SITE_URL,
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "سياسة الخصوصية",
            item: PAGE_URL,
        },
    ],
};

// JSON-LD Combined
const jsonLd = JSON.stringify([breadcrumbSchema]);
---

<Layout
    title={PAGE_TITLE}
    description={PAGE_DESCRIPTION}
    url={PAGE_URL}
    image={LOGO_URL}
>
    <Fragment slot="head">
        <script type="application/ld+json" set:html={jsonLd} is:inline></script>
    </Fragment>

    <main class="w-full flex flex-col bg-slate-50 min-h-screen pb-20">
        {/* HEADER */}
        <section
            class="w-full py-16 bg-slate-900 border-b border-slate-800 flex justify-center text-center px-4"
        >
            <div class="max-w-3xl">
                <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">
                    سياسة الخصوصية
                </h1>
                <p class="text-slate-400">آخر تحديث: 20 فبراير 2026</p>
            </div>
        </section>

        {/* CONTENT */}
        <section class="max-w-4xl mx-auto px-4 mt-[-2rem] relative z-10">
            <div
                class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8 md:p-12 prose prose-slate prose-lg max-w-none prose-a:text-amber-600 prose-headings:text-slate-800"
            >
                <h2>مقدمة</h2>
                <p>
                    نحن في مؤسسة <strong>{BRAND}</strong> (والتي سيُشار إليها بـ
                    "نحن" أو "الموقع") نضع خصوصية زوار وعملاء موقعنا في المقام الأول.
                    توضح سياسة الخصوصية هذه أنواع المعلومات الشخصية التي نتلقاها
                    ونجمعها عند استخدامك لموقعنا الإلكتروني (<a href={SITE_URL}
                        >{SITE_URL}</a
                    >) وكيف نقوم بحماية تلك المعلومات.
                </p>

                <h2>المعلومات التي نجمعها</h2>
                <p>
                    نقوم بجمع معلوماتك الشخصية فقط عند قيامك بمراسلتنا طواعية عن
                    طريق نموذج "اتصل بنا" أو النقر على أزرار التواصل المباشر
                    (مثل زر الواتساب أو المكالمات الهاتفية). المعلومات التي قد
                    نجمعها تتضمن (على سبيل المثال لا الحصر):
                </p>
                <ul>
                    <li>الاسم كاملاً.</li>
                    <li>رقم الهاتف أو رقم الواتساب الخاص بك.</li>
                    <li>
                        تفاصيل المشروع المراد تنفيذ أعمال التخريم أو القص فيه.
                    </li>
                </ul>

                <h2>كيفية استخدام المعلومات</h2>
                <p>
                    البيانات التي نحصل عليها يتم استخدامها حصرياً للأغراض
                    التالية:
                </p>
                <ul>
                    <li>
                        التواصل معك لتقديم الاستشارات وإرسال عروض الأسعار
                        (المقايسات والأسعار).
                    </li>
                    <li>تحسين استجابة خدمة العملاء لدينا وتوفير دعم أقوى.</li>
                    <li>
                        عدم بيع هذه المعلومات أو مشاركتها أو تأجيرها أو تسريبها
                        إلى أي جهات خارجية أو أطراف ثالثة لأغراض دعائية أو
                        غيرها.
                    </li>
                </ul>

                <h2>أمن البيانات</h2>
                <p>
                    نحن نتخذ الإجراءات الفنية والإدارية المناسبة لحماية بياناتك
                    من الدخول غير المصرح به أو التعديل أو الإفصاح عنه أو إتلافه.
                    يتم تشفير الموقع بالكامل ببروتوكول HTTPS لحماية البيانات
                    المرسلة عبر الإنترنت.
                </p>

                <h2>ملفات تعريف الارتباط (Cookies)</h2>
                <p>
                    قد يستخدم موقع {BRAND} ملفات تعريف الارتباط بغرض تحسين تجربة
                    المستخدم وتحليل تدفق الزوار للموقع من خلال أدوات إحصائية (مثل
                    Google Analytics)، وهي لا تجمع معلومات شخصية قادرة على تحديد
                    هويتك المباشرة. يمكنك دوماً إيقاف ملفات تعريف الارتباط من خلال
                    إعدادات متصفحك.
                </p>

                <h2>الموافقة على السياسة</h2>
                <p>
                    باستخدامك لموقعنا، فإنك توافق ضمنياً على سياسة الخصوصية
                    الخاصة بنا وشروط وظروف الاستخدام الواردة فيها.
                </p>

                <h2>تعديلات على سياسة الخصوصية</h2>
                <p>
                    يحتفظ موقع رواد الخرسانة بالحق في إجراء تعديلات أو تحديثات
                    على سياسة الخصوصية هذه سواء بشكل كلي أو جزئي في أي وقت بما
                    يتوافق مع القوانين والخدمات الجديدة، وسنقوم بتحديث تاريخ
                    "آخر تحديث" أعلى هذه الصفحة.
                </p>

                <h2>اتصل بنا</h2>
                <p>
                    إذا كانت لديك أية أسئلة أو استفسارات تتعلق بسياسة الخصوصية
                    هذه، نسعد بتواصلك معنا عبر:
                </p>
                <ul>
                    <li>صفحة التواصل: <a href="/contact">اتصل بنا</a></li>
                    <li>رقم الهاتف / الواتساب: 01070046464</li>
                </ul>
            </div>
        </section>
    </main>
</Layout>

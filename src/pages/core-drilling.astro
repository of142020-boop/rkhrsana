---
// src/pages/core-drilling.astro
import Layout from "../layouts/Layout.astro";

/**
 * ✅ صفحة محسّنة ومتفوقة:
 * - سكيما أقوى: FAQ + LocalBusiness + Organization + Service + WebPage + Breadcrumb
 * - توحيد أسئلة FAQ (UI + Schema) ✅
 * - جدول تنقّل سريع + IDs للأقسام ✅
 * - قسم ثقة/سلامة (E-E-A-T) ✅
 * - معرض مشاريع (Placeholders جاهزة للاستبدال بصورك) ✅
 * - إزالة نماذج التسعير والاعتماد على التوجيه المباشر لصفحة التواصل ✅
 * - تغطية جغرافية شاملة لجميع أنحاء مصر ✅
 * - Meta Title احترافي مدمج به الكلمة المفتاحية ورقم الهاتف (SEO + CTR) ✅
 */

// ====== بيانات أساسية ======
const BRAND = "رواد الخرسانة";
const PHONE = "01070046464"; // تمت إضافته لاستخدامه في الـ Meta Title
const PAGE_URL = "https://rkhrsana.com/core-drilling";
const SITE_URL = "https://rkhrsana.com";
const LOGO_URL = "https://rkhrsana.com/images/og-core.webp";

const PAGE_TITLE = `فتحات كور وتخريم الخرسانة المسلحة بدقة | اتصل ${PHONE}`;
const PAGE_DESCRIPTION = `دليل شامل لخدمات فتحات كور وتخريم الخرسانة المسلحة بأحدث ماكينة الكور. دقة عالية بدون تكسير لعمل فتحات الغاز، مدخنة السخان، التكييف. نصلك في أي مكان في مصر.`;

// ====== FAQ موحّد: نفس الأسئلة ستظهر في الصفحة + Schema ======
const faqItems = [
  {
    q: "هل فتحات الكور آمنة على الخرسانة المسلحة؟",
    a: "نعم، إذا تم التنفيذ باستخدام ماكينة الكور الماسية الصحيحة بواسطة فنيين محترفين، فإن تخريم الخرسانة المسلحة بالكور يعد الطريقة الأكثر أماناً لأنه يمنع الاهتزازات التي تسبب الشروخ الدقيقة في الهيكل الإنشائي.",
  },
  {
    q: "كم يبلغ سعر فتحة الكور؟",
    a: "تتفاوت اسعار فتحات الكور بناءً على قطر الفتحة، عمق الخرسانة، نوعها (مسلحة أم عادية)، وموقع العمل. يرجى التواصل معنا من خلال صفحة الاتصال للحصول على تسعير دقيق وفوري.",
  },
  {
    q: "هل يمكن عمل فتحة مدخنة السخان دون تشويه الحائط؟",
    a: "بالتأكيد. تقنية الكور دريل تضمن عمل فتحة دائرية مثالية الحواف لمدخنة السخان أو مواسير الغاز دون أي تكسير عشوائي أو تشويه للدهانات المحيطة.",
  },
  {
    q: "هل تقومون بفتح كور في الكمر الإنشائي؟",
    a: "فتح كور في الكمر يعتبر عملية حساسة هندسياً. نقوم بتنفيذها فقط بعد التأكد من عدم المساس بحديد التسليح الرئيسي وبعد استشارة المهندس الإنشائي المسؤول عن الموقع لضمان سلامة المبنى.",
  },
  {
    q: "هل ينفع تخريم السقف داخل شقة متشطبة ومفروشة؟",
    a: "ينفع بالطبع، لكن هذا يتطلب تجهيزاً خاصاً. نقوم بعمل حماية وتغطية شاملة للأرضيات والأثاث بالبلاستيك. التنفيذ الاحترافي لدينا يركز على تقليل الفوضى واستخدام أنظمة تجميع مياه متطورة للحفاظ على نظافة المكان قدر المستطاع.",
  },
  {
    q: "هل كل عملية فتح كور لازم يكون فيها مياه وتغرق الدنيا؟",
    a: "مش شرط بالشكل السيء اللي الناس بتتخيله. الهدف الأساسي للمياه هو تبريد الأداة الألماسية وتحسين القطع وتقليل الغبار والحرارة. نستخدم أنظمة تجميع مياه متطورة وشفط مناسب لتقليل الفوضى داخل الشقق المتشطبة.",
  },
  {
    q: "هل يمكن عمل فتحات الغاز وفتحة مدخنة السخان في نفس الزيارة؟",
    a: "أكيد، وده غالباً بيكون أوفر وأسرع للعميل. تحديد كل الفتحات المطلوبة مسبقًا عند التواصل معنا يساعدنا على تحضير المقاسات (البنط) والأدوات المناسبة لإنهاء العمل بالكامل في زيارة واحدة.",
  },
  {
    q: 'ما المقصود بـ "ماكينة تخريم خرسانة" و"كور دريل"؟',
    a: "في سوق المقاولات الناس بتستخدم مصطلحات مختلفة زي: ماكينة تخريم خرسانة، ماكينة الكور، ماكينة كور تخريم الخرسانة، كور دريل، أو دريل كور... جميعها تشير لنفس الفكرة والماكينة: جهاز متخصص قوي لعمل فتحات دائرية دقيقة في الخرسانة.",
  },
];

// ====== Schema: FAQPage ======
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((x) => ({
    "@type": "Question",
    name: x.q,
    acceptedAnswer: { "@type": "Answer", text: x.a },
  })),
};

// ====== Schema: LocalBusiness ======
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "رواد الخرسانة لقص وتخريم الخرسانة",
  image: LOGO_URL,
  address: {
    "@type": "PostalAddress",
    addressCountry: "EG",
  },
  url: PAGE_URL,
  priceRange: "$$",
};

// ====== Schema: Organization ======
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "رواد الخرسانة لقص وتخريم الخرسانة",
  url: SITE_URL,
  logo: LOGO_URL,
  sameAs: ["https://www.facebook.com/", "https://www.instagram.com/"],
};

// ====== Schema: Service ======
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "فتحات كور وتخريم الخرسانة المسلحة",
  serviceType: "Core Drilling",
  provider: {
    "@type": "LocalBusiness",
    name: "رواد الخرسانة لقص وتخريم الخرسانة",
    url: PAGE_URL,
  },
  areaServed: [{ "@type": "Country", name: "Egypt" }],
  url: PAGE_URL,
};

// ====== Schema: WebPage ======
const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: PAGE_TITLE,
  url: PAGE_URL,
  isPartOf: { "@type": "WebSite", name: "rkhrsana", url: SITE_URL },
};

// ====== Schema: Breadcrumb ======
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "الرئيسية",
      item: `${SITE_URL}/`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "فتحات كور وتخريم الخرسانة",
      item: PAGE_URL,
    },
  ],
};
---

<Layout
  title={PAGE_TITLE}
  description={PAGE_DESCRIPTION}
  image="/images/og-core.webp"
>
  {/* ✅ حقن أكواد Schema في رأس الصفحة */}
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}
  ></script>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(localBusinessSchema)}
  ></script>
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)}
  ></script>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)}
  ></script>
  <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)}
  ></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}
  ></script>

  {/* ========================================= */}
  {/* 1) Hero Section */}
  {/* ========================================= */}
  <section
    class="relative bg-slate-900 text-white py-24 lg:py-32 overflow-hidden border-b-4 border-yellow-500"
  >
    <div class="absolute inset-0 bg-slate-800 opacity-90"></div>
    <div
      class="absolute inset-0 bg-[url('/images/core-drilling/core-drilling-hero.webp')] bg-cover bg-center mix-blend-overlay opacity-25"
    >
    </div>

    <div class="relative z-10 container mx-auto px-4 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <span
          class="inline-block bg-yellow-500 text-slate-900 font-bold px-4 py-1 rounded-full text-sm md:text-base mb-6 shadow-lg"
        >
          الحل الهندسي النظيف والآمن الأول في مصر
        </span>

        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-extrabold mb-6 leading-tight text-white drop-shadow-lg"
        >
          فتحات كور وتخريم الخرسانة المسلحة بدقة وبدون تكسير
        </h1>

        <p
          class="text-lg md:text-2xl mb-10 text-slate-300 leading-relaxed font-light"
        >
          إذا كنت تبحث عن حل "نظيف" وآمن لعمل فتحات في الخرسانة بدون تكسير
          عشوائي أو إضعاف للمنشأ، فخدمة{" "}
          <strong class="text-white font-bold">فتحات كور</strong> هي الاختيار الصحيح.
          مقاول فتحات كور محترف لخدمتك في كافة محافظات جمهورية مصر العربية.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/contact"
            class="inline-flex items-center justify-center gap-3 bg-yellow-500 text-slate-900 px-8 py-4 rounded-lg text-xl font-bold hover:bg-yellow-400 hover:scale-105 transition-all shadow-xl shadow-yellow-500/20"
          >
            تواصل معنا واطلب تسعير لمشروعك
          </a>

          <a
            href="#comprehensive-guide"
            class="inline-flex items-center justify-center gap-2 bg-transparent border-2 border-slate-600 text-white px-8 py-4 rounded-lg text-lg font-medium hover:border-yellow-500 hover:text-yellow-500 transition-colors"
          >
            اقرأ الدليل الشامل للخدمة ↓
          </a>
        </div>

        <p class="mt-8 text-sm text-slate-400">
          نغطي جميع محافظات جمهورية مصر العربية ونصل إليك أينما كنت.
        </p>
      </div>
    </div>
  </section>

  {/* ========================================= */}
  {/* 2) مقدمة + جدول تنقل سريع */}
  {/* ========================================= */}
  <section id="comprehensive-guide" class="py-16 bg-white">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="max-w-5xl mx-auto text-right">
        {/* جدول تنقل */}
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 mb-10">
          <div class="flex flex-wrap gap-3 justify-end">
            <a
              href="#services"
              class="px-4 py-2 rounded-lg bg-white border border-slate-200 hover:border-yellow-500"
            >
              الخدمات
            </a>
            <a
              href="#equipment"
              class="px-4 py-2 rounded-lg bg-white border border-slate-200 hover:border-yellow-500"
            >
              المعدات
            </a>
            <a
              href="#pricing"
              class="px-4 py-2 rounded-lg bg-white border border-slate-200 hover:border-yellow-500"
            >
              الأسعار
            </a>
            <a
              href="#gallery"
              class="px-4 py-2 rounded-lg bg-white border border-slate-200 hover:border-yellow-500"
            >
              مشاريعنا
            </a>
            <a
              href="#faq"
              class="px-4 py-2 rounded-lg bg-white border border-slate-200 hover:border-yellow-500"
            >
              الأسئلة الشائعة
            </a>
            <a
              href="/contact"
              class="px-4 py-2 rounded-lg bg-yellow-500 font-bold text-slate-900"
            >
              تواصل معنا
            </a>
          </div>
        </div>

        <div class="prose prose-lg prose-slate max-w-none">
          <h2 class="text-3xl font-bold text-slate-900 mb-6">
            الدليل الشامل: ما هي فتحات الكور ولماذا أصبحت ضرورة هندسية؟
          </h2>

          <p class="text-slate-700 leading-loose mb-6">
            الناس بطبيعة الحال تحتاج إلى عمل فتحات في الخرسانة لأسباب لا حصر
            لها: تمديدات سباكة معقدة، تمرير مواسير تكييف، تركيب شفاطات دقيقة،
            تمرير كابلات كهربائية ضخمة، تثبيت قواعد أعمدة، أو حتى عمل فتحات
            تهوية في البدرومات. لكن <strong
              >الأخطر دائماً هو تنفيذ هذه الفتحات بطريقة خاطئة أو عشوائية</strong
            >.
          </p>

          <p class="text-slate-700 leading-loose mb-6">
            أي تخريم غير محسوب باستخدام "الجاك هامر" (الهمر) أو الأجنة والمطرقة
            قد يسبب شروخاً ميكروية (Micro-cracks) في الهيكل الإنشائي، أو يؤدي
            إلى قطع حديد التسليح بشكل عشوائي يدمر قوة التحمل، ناهيك عن
            الاهتزازات العنيفة التي تؤثر على الأجزاء القريبة والمباني المجاورة.
            علشان كده، نحن في "{BRAND}" نقدم خدمة{" "}
            <strong class="text-yellow-600">كور تخريم الخرسانة</strong> بحسابات هندسية
            واضحة، ومعدات ألمانية مخصصة، وتنفيذ منظم يراعي السلامة المطلقة وجودة
            التشطيب الفائقة.
          </p>

          <p class="text-slate-700 leading-loose">
            فتحات الكور (Core Drilling) هي باختصار الطريقة الاحترافية الحديثة
            لعمل فتحات دائرية دقيقة جداً داخل الخرسانة العادية أو المسلحة، وذلك
            باستخدام معدات متخصصة مثل{" "}
            <strong class="text-yellow-600">ماكينة كور تخريم الخرسانة</strong> المجهزة
            ببنط من الألماس الصناعي (Diamond Core Bits)، مع تثبيت قوي يضمن تحكماً
            كاملاً في المقاس (القطر)، والعمق، والاتجاه الدقيق دون أي ميل غير محسوب.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ========================================= */}
  {/* 3) لماذا الكور أفضل؟ */}
  {/* ========================================= */}
  <section class="py-20 bg-slate-50 border-t border-slate-200">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">
          لماذا "فتحات كور" أفضل من التكسير أو التخريم العشوائي؟
        </h2>
        <div class="w-24 h-1 bg-yellow-500 mx-auto rounded-full mb-6"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-6xl mx-auto">
        <div
          class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100 flex flex-col md:flex-row gap-6 hover:shadow-md transition-shadow"
        >
          <div
            class="w-16 h-16 shrink-0 bg-slate-900 text-yellow-500 rounded-2xl flex items-center justify-center text-3xl font-black"
          >
            1
          </div>
          <div>
            <h3 class="text-2xl font-bold text-slate-800 mb-3">
              دقة متناهية في المقاس والمكان
            </h3>
            <p class="text-slate-600 leading-relaxed">
              الفتحة بتطلع بالمقاس المطلوب بالملّي—بدءاً من أصغر قطر لمرور كابل
              إنترنت، وحتى أقطار كبيرة جداً لتهوية المصانع حسب الحاجة. سواء كنت
              محتاج فتحة كور لماسورة تكييف سبليت أو فتحة أكبر لتهوية أو شفاط،
              الدقة هنا تمنع إعادة الشغل، توفر هدر المواد، وتقلل المخاطر
              الإنشائية تماماً.
            </p>
          </div>
        </div>

        <div
          class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100 flex flex-col md:flex-row gap-6 hover:shadow-md transition-shadow"
        >
          <div
            class="w-16 h-16 shrink-0 bg-slate-900 text-yellow-500 rounded-2xl flex items-center justify-center text-3xl font-black"
          >
            2
          </div>
          <div>
            <h3 class="text-2xl font-bold text-slate-800 mb-3">
              أقل اهتزاز وأقل ضرر للخرسانة
            </h3>
            <p class="text-slate-600 leading-relaxed">
              في عمليات <strong class="text-slate-800"
                >تخريم الخرسانة المسلحة</strong
              > بالكور، الماكينة مصممة لتقطع الخرسانة والحديد تدريجيًا بالاحتكاك
              الألماسي وليس بالطرق. هذا الأسلوب يقلل الاهتزاز مقارنة بطرق التكسير
              أو الشنيور الدقاق العادي. ده يحافظ بشكل مباشر على المناطق المحيطة من
              الشروخ ويحمي عمر المبنى.
            </p>
          </div>
        </div>

        <div
          class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100 flex flex-col md:flex-row gap-6 hover:shadow-md transition-shadow"
        >
          <div
            class="w-16 h-16 shrink-0 bg-slate-900 text-yellow-500 rounded-2xl flex items-center justify-center text-3xl font-black"
          >
            3
          </div>
          <div>
            <h3 class="text-2xl font-bold text-slate-800 mb-3">
              تشطيب أنظف يسهل الأعمال اللاحقة
            </h3>
            <p class="text-slate-600 leading-relaxed">
              الطرق العشوائية تترك حوافاً متعرجة ومكسرة. أما فتحة الكور بتطلع
              ناعمة الحواف أسطوانية الشكل ومثالية، وده يسهل جداً تركيب المواسير
              أو عمل العزل المائي الدقيق، أو تثبيت الجلب (Sleeves) المعدنية والـ
              PVC بدون الحاجة لأعمال محارة وإعادة تكسير وترميم مكلفة.
            </p>
          </div>
        </div>

        <div
          class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100 flex flex-col md:flex-row gap-6 hover:shadow-md transition-shadow"
        >
          <div
            class="w-16 h-16 shrink-0 bg-slate-900 text-yellow-500 rounded-2xl flex items-center justify-center text-3xl font-black"
          >
            4
          </div>
          <div>
            <h3 class="text-2xl font-bold text-slate-800 mb-3">
              قوة قاهرة للخرسانة المسلحة والصلبة
            </h3>
            <p class="text-slate-600 leading-relaxed">
              سواء كانت خرسانة عادية، مسلحة بكثافة حديد عالية، أو حتى جدران
              حجرية، فإن{" "}
              <strong class="text-slate-800">شركة تخريم خرسانة</strong> محترفة توفر
              المعدات المناسبة والتقنيات الصحيحة التي تجعل التنفيذ ممكناً، سريعاً،
              وآمناً في أصعب الظروف الإنشائية.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ========================================= */}
  {/* 4) خدماتنا الأساسية (ID: services) */}
  {/* ========================================= */}
  <section id="services" class="py-20 bg-white">
    <div class="container mx-auto px-4 lg:px-8 max-w-6xl">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-5xl font-bold text-slate-900 mb-6">
          خدماتنا الأساسية في تخريم الخرسانة بالكور
        </h2>
        <p class="text-lg text-slate-600 max-w-3xl mx-auto">
          نقدم في "{BRAND}" كل ما يتعلق بـ <strong>عمل فتحات كور</strong> داخل الخرسانة،
          بما يناسب احتياجك الفردي أو مشروعك التجاري بدقة واحترافية عالية:
        </p>
      </div>

      <div class="space-y-12">
        <div
          class="flex flex-col md:flex-row gap-8 items-center bg-slate-50 rounded-2xl overflow-hidden border border-slate-100"
        >
          <div class="w-full md:w-1/3 h-64 bg-slate-200 relative">
            <img

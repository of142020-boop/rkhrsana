---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");
const sortedPosts = allPosts.sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout
    title="المدونة"
    description="مقالات وأخبار رواد الخرسانة في مجال قص وتخريم الخرسانة وتزريع الأشاير."
>
    <div class="bg-slate-900 py-16 md:py-24 relative overflow-hidden">
        <div
            class="absolute inset-0 bg-[url('/images/hero-bg.webp')] opacity-20 bg-cover bg-center"
        >
        </div>
        <div class="absolute inset-0 bg-slate-900/80"></div>
        <div class="container mx-auto px-4 lg:px-8 relative z-10 text-center">
            <p class="text-yellow-500 font-bold mb-4 tracking-wider">
                مقالات وأخبار
            </p>
            <h1
                class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white mb-6 leading-tight"
            >
                المدونة <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-yellow-400 to-yellow-600"
                    >الهندسية</span
                >
            </h1>
            <p
                class="text-slate-300 max-w-2xl mx-auto text-lg md:text-xl leading-relaxed"
            >
                اكتشف أحدث المقالات والنصائح في مجال قص وتخريم الخرسانة، وتزريع
                الأشاير الكيميائية.
            </p>
        </div>
    </div>

    <section class="py-16 md:py-24 bg-slate-50 relative">
        <!-- Subtle Pattern Background -->
        <div
            class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMjAiIGhlaWdodD0iMjAiIHhtbG5zPSJodHRwOi8vd3d3LnczLm9yZy8yMDAwL3N2ZyI+PHBhdGggZD0iTTEgMWgydjJIMXoiIGZpbGw9IiNlMmU4ZjAiIGZpbGwtcnVsZT0iZXZlbm9kZCIvPjwvc3ZnPg==')] opacity-[0.3]"
        >
        </div>

        <div class="container mx-auto px-4 lg:px-8 relative z-10">
            {
                sortedPosts.length === 0 ? (
                    <div class="text-center text-slate-500 py-12 bg-white rounded-3xl shadow-sm border border-slate-100 max-w-2xl mx-auto">
                        <svg
                            class="w-16 h-16 mx-auto mb-4 text-slate-300"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10l6 6v10a2 2 0 01-2 2z"
                            />
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="1.5"
                                d="M14 4v5h5M7 10h4m-4 4h8"
                            />
                        </svg>
                        <p class="text-xl font-medium">
                            لا توجد مقالات منشورة حالياً.
                        </p>
                        <p class="text-slate-400 mt-2 text-sm">
                            سيتم إضافة محتوى جديد قريباً.
                        </p>
                    </div>
                ) : (
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
                        {sortedPosts.map((post) => (
                            <article class="bg-white rounded-3xl shadow-lg border border-slate-100 overflow-hidden group hover:shadow-xl transition-all duration-300 flex flex-col h-full hover:-translate-y-2 ring-1 ring-transparent hover:ring-yellow-500/20">
                                {post.data.image && (
                                    <div class="relative h-64 overflow-hidden bg-slate-100">
                                        <img
                                            src={post.data.image}
                                            alt={post.data.title}
                                            class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700 ease-out"
                                            loading="lazy"
                                        />
                                        <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-transparent to-transparent opacity-80" />
                                        <div class="absolute bottom-5 right-5 bg-yellow-500/95 backdrop-blur-sm text-slate-900 text-xs font-bold px-4 py-1.5 rounded-full shadow-lg border border-yellow-400">
                                            {post.data.date.toLocaleDateString(
                                                "ar-EG",
                                                {
                                                    year: "numeric",
                                                    month: "long",
                                                    day: "numeric",
                                                }
                                            )}
                                        </div>
                                    </div>
                                )}
                                <div class="p-8 flex flex-col flex-grow relative">
                                    <h2 class="text-2xl font-bold text-slate-800 mb-4 group-hover:text-yellow-600 transition-colors leading-snug line-clamp-2">
                                        <a
                                            href={`/blog/${post.slug}`}
                                            class="focus:outline-none"
                                        >
                                            <span
                                                class="absolute inset-0 z-10"
                                                aria-hidden="true"
                                            />
                                            {post.data.title}
                                        </a>
                                    </h2>
                                    <p class="text-slate-600 mb-8 flex-grow leading-relaxed line-clamp-3">
                                        {post.data.description}
                                    </p>
                                    <div class="flex items-center text-yellow-600 font-bold group-hover:translate-x-[-8px] transition-transform duration-300 mt-auto pt-4 border-t border-slate-50">
                                        <span class="text-sm">
                                            أكمل القراءة
                                        </span>
                                        <svg
                                            class="w-5 h-5 mr-2 transform rotate-180"
                                            fill="none"
                                            stroke="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M17 8l4 4m0 0l-4 4m4-4H3"
                                            />
                                        </svg>
                                    </div>
                                </div>
                            </article>
                        ))}
                    </div>
                )
            }
        </div>
    </section>
</Layout>

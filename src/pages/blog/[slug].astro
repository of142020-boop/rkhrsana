---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map((post) => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Layout
    title={post.data.title}
    description={post.data.description || ""}
    image={post.data.image}
>
    <div class="bg-slate-50 py-12 md:py-20">
        <div class="container mx-auto px-4 lg:px-8">
            <div
                class="max-w-4xl mx-auto bg-white rounded-3xl shadow-xl overflow-hidden border border-slate-100"
            >
                <!-- Post Header -->
                {
                    post.data.image && (
                        <div class="relative h-64 md:h-96 w-full">
                            <img
                                src={post.data.image}
                                alt={post.data.title}
                                class="w-full h-full object-cover"
                            />
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-transparent to-transparent" />
                            <div class="absolute bottom-6 px-6 md:px-12">
                                <span class="bg-yellow-500 text-slate-900 text-sm font-bold px-4 py-1.5 rounded-full mb-4 inline-block shadow-lg">
                                    <time
                                        datetime={post.data.date.toISOString()}
                                    >
                                        {post.data.date.toLocaleDateString(
                                            "ar-EG",
                                            {
                                                year: "numeric",
                                                month: "long",
                                                day: "numeric",
                                            }
                                        )}
                                    </time>
                                </span>
                                <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-white leading-tight">
                                    {post.data.title}
                                </h1>
                            </div>
                        </div>
                    )
                }

                <!-- Post Content Header (if no image) -->
                {
                    !post.data.image && (
                        <div class="px-6 md:px-12 pt-12 pb-6 border-b border-slate-100">
                            <span class="bg-yellow-500 text-slate-900 text-sm font-bold px-4 py-1.5 rounded-full mb-4 inline-block shadow-lg">
                                <time datetime={post.data.date.toISOString()}>
                                    {post.data.date.toLocaleDateString(
                                        "ar-EG",
                                        {
                                            year: "numeric",
                                            month: "long",
                                            day: "numeric",
                                        }
                                    )}
                                </time>
                            </span>
                            <h1 class="text-3xl md:text-5xl font-extrabold text-slate-900 leading-tight">
                                {post.data.title}
                            </h1>
                        </div>
                    )
                }

                <!-- Post Content Body -->
                <article class="px-6 md:px-12 py-10">
                    <div
                        class="prose prose-lg md:prose-xl max-w-none prose-slate prose-headings:font-bold prose-headings:text-slate-800 prose-a:text-yellow-600 hover:prose-a:text-yellow-700 prose-img:rounded-xl prose-img:shadow-md"
                    >
                        <Content />
                    </div>
                </article>
            </div>

            <!-- Back to Blog Button -->
            <div class="max-w-4xl mx-auto mt-12 text-center">
                <a
                    href="/blog"
                    class="inline-flex items-center justify-center gap-2 bg-slate-900 text-white px-8 py-3 rounded-full font-bold hover:bg-slate-800 transition-colors shadow-lg hover:-translate-y-1 transform duration-300"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                    العودة للمدونة
                </a>
            </div>
        </div>
    </div>
</Layout>

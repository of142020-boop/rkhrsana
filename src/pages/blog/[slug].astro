---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map((post) => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// Calculate viewing URL for social sharing
const currentUrl = new URL(Astro.url.pathname, Astro.site || Astro.url.origin)
    .href;
const encodedUrl = encodeURIComponent(currentUrl);
const encodedTitle = encodeURIComponent(post.data.title);

const shareLinks = {
    facebook: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
    twitter: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`,
    whatsapp: `https://api.whatsapp.com/send?text=${encodedTitle}%20${encodedUrl}`,
    linkedin: `https://www.linkedin.com/shareArticle?mini=true&url=${encodedUrl}&title=${encodedTitle}`,
};
---

<Layout
    title={post.data.title}
    description={post.data.description || ""}
    image={post.data.image}
>
    <!-- Premium Article Hero -->
    <div
        class="relative bg-slate-900 pt-20 pb-32 md:pt-28 md:pb-40 overflow-hidden border-b-4 border-yellow-500"
    >
        <!-- The featured image is no longer a background here -->
        <div class="container mx-auto px-4 lg:px-8 relative z-10">
            <div class="max-w-4xl mx-auto text-center">
                <span
                    class="inline-block bg-yellow-500/10 text-yellow-400 border border-yellow-500/30 font-bold px-4 py-1.5 rounded-full mb-6 backdrop-blur-sm text-sm tracking-wide"
                >
                    <time datetime={post.data.date.toISOString()}>
                        {
                            post.data.date.toLocaleDateString("ar-EG", {
                                year: "numeric",
                                month: "long",
                                day: "numeric",
                            })
                        }
                    </time>
                </span>
                <h1
                    class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6 drop-shadow-lg"
                >
                    {post.data.title}
                </h1>
                {
                    post.data.description && (
                        <p class="text-xl md:text-2xl text-slate-300 leading-relaxed max-w-3xl mx-auto drop-shadow-md">
                            {post.data.description}
                        </p>
                    )
                }
            </div>
        </div>
    </div>

    <!-- Article Content -->
    <div class="bg-slate-50 pb-16">
        <div class="container mx-auto px-4 lg:px-8">
            <div
                class="max-w-4xl mx-auto bg-white rounded-3xl shadow-2xl overflow-hidden border border-slate-100 -mt-20 relative z-20"
            >
                {
                    post.data.image && (
                        <div class="w-full flex justify-center px-6 md:px-16 pt-12 md:pt-16 pb-4">
                            <div class="relative rounded-2xl overflow-hidden border-4 border-slate-50 shadow-lg w-full max-w-2xl bg-slate-100 aspect-square md:aspect-[4/3]">
                                <img
                                    src={post.data.image}
                                    alt={post.data.title}
                                    class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
                                />
                            </div>
                        </div>
                    )
                }

                <article class="px-6 md:px-16 py-8 md:py-12">
                    <div
                        class="prose prose-lg md:prose-xl max-w-none prose-slate prose-headings:font-bold prose-headings:text-slate-800 prose-a:text-yellow-600 hover:prose-a:text-yellow-700 prose-img:rounded-2xl prose-img:shadow-lg prose-hr:border-slate-200 prose-img:max-w-full prose-img:mx-auto prose-img:object-contain"
                    >
                        <Content />
                    </div>
                </article>

                <!-- Social Sharing -->
                <div
                    class="bg-slate-50 px-6 md:px-16 py-8 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-6"
                >
                    <h3 class="text-lg font-bold text-slate-700">
                        شارك هذا المقال مع المهتمين:
                    </h3>
                    <div class="flex items-center gap-3">
                        <!-- Facebook -->
                        <a
                            href={shareLinks.facebook}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="شارك على فيسبوك"
                            class="w-12 h-12 rounded-full bg-white border border-slate-200 shadow-sm flex items-center justify-center text-slate-500 hover:bg-[#1877F2] hover:text-white hover:border-[#1877F2] transition-all transform hover:-translate-y-1"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                                ></path>
                            </svg>
                        </a>
                        <!-- Twitter/X -->
                        <a
                            href={shareLinks.twitter}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="شارك على تويتر"
                            class="w-12 h-12 rounded-full bg-white border border-slate-200 shadow-sm flex items-center justify-center text-slate-500 hover:bg-black hover:text-white hover:border-black transition-all transform hover:-translate-y-1"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                                ></path>
                            </svg>
                        </a>
                        <!-- WhatsApp -->
                        <a
                            href={shareLinks.whatsapp}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="شارك على واتساب"
                            class="w-12 h-12 rounded-full bg-white border border-slate-200 shadow-sm flex items-center justify-center text-slate-500 hover:bg-[#25D366] hover:text-white hover:border-[#25D366] transition-all transform hover:-translate-y-1"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                                ></path>
                            </svg>
                        </a>
                        <!-- LinkedIn -->
                        <a
                            href={shareLinks.linkedin}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label="شارك على لينكد إن"
                            class="w-12 h-12 rounded-full bg-white border border-slate-200 shadow-sm flex items-center justify-center text-slate-500 hover:bg-[#0A66C2] hover:text-white hover:border-[#0A66C2] transition-all transform hover:-translate-y-1"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                                ></path>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Back to Blog Button -->
            <div class="max-w-4xl mx-auto mt-12 text-center pb-8">
                <a
                    href="/blog"
                    class="inline-flex items-center justify-center gap-2 bg-slate-900 text-white px-8 py-4 rounded-full font-bold hover:bg-slate-800 transition-colors shadow-lg hover:-translate-y-1 transform duration-300 ring-2 ring-transparent hover:ring-yellow-500/50"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                    العودة لجميع المقالات
                </a>
            </div>
        </div>
    </div>
</Layout>

---
// src/pages/rebar-planting.astro
import Layout from "../layouts/Layout.astro";

/**
 * ✅ صفحة محسّنة ومتفوقة لخدمة: تزريع الأشاير
 * - Schema قوي: FAQ + LocalBusiness + Organization + Service + WebPage + Breadcrumb
 * - FAQ موحّد (UI + Schema)
 * - جدول تنقّل سريع + IDs للأقسام
 * - قسم ثقة/سلامة (E-E-A-T)
 * - معرض مشاريع Placeholders
 * - إزالة نماذج التسعير وأزرار الواتساب/الاتصال والاعتماد على التوجيه لصفحة التواصل ✅
 * - تغطية جغرافية شاملة لجميع أنحاء مصر ✅
 * - Meta Title احترافي مدمج به الكلمة المفتاحية ورقم الهاتف (SEO + CTR) ✅
 */

// ====== بيانات أساسية ======
const BRAND = "رواد الخرسانة";
const PHONE = "01070046464"; // مخصص للميتا تايتل فقط
const PAGE_URL = "https://rkhrsana.com/rebar-planting";
const SITE_URL = "https://rkhrsana.com";
const LOGO_URL = "https://rkhrsana.com/images/og-rebar.webp";

const PAGE_TITLE = `تزريع الأشاير الكيميائي وتثبيت الأنكر بأمان | اتصل ${PHONE}`;
const PAGE_DESCRIPTION = `تزريع أشاير (Rebar) وتثبيت أنكر كيميائي بمواد معتمدة وخطوات تنفيذ صحيحة: حفر مضبوط، تنظيف احترافي، حقن صحيح، وزمن تصلب. نصلك في أي مكان في مصر.`;

// ====== FAQ موحّد: نفس الأسئلة ستظهر في الصفحة + Schema ======
const faqItems = [
  {
    q: "ما هو تزريع الأشاير الكيميائي؟",
    a: "تزريع الأشاير هو تثبيت سيخ تسليح داخل خرسانة قائمة باستخدام مادة كيميائية معتمدة (إيبوكسي/ريزن) لربط الخرسانة القديمة بالجديدة أو تثبيت عناصر إنشائية وأنكرات بأمان.",
  },
  {
    q: "هل تزريع الأشاير آمن على الخرسانة المسلحة؟",
    a: "نعم إذا تم تحديد القطر والعمق الصحيحين، وتنظيف الثقب بالكامل، واستخدام مادة أصلية مناسبة للحمل، والالتزام بزمن التصلب قبل التحميل. الخطر الحقيقي يأتي من التنفيذ العشوائي.",
  },
  {
    q: "هل يمكن تزريع أشاير في السقف (تطبيق علوي)؟",
    a: "نعم بشرط استخدام مادة مناسبة للتطبيقات العلوية، وتنفيذ تنظيف ممتاز للثقوب، وحقن صحيح يمنع الهبوط، ثم الانتظار لزمن التصلب الكامل قبل أي حمل.",
  },
  {
    q: "كم سعر تزريع الأشاير؟",
    a: "سعر التزريع يعتمد على قطر السيخ، العمق، عدد الأشاير، نوع الخرسانة، صعوبة الوصول، ونوع المادة المستخدمة. يرجى التواصل معنا من خلال صفحة الاتصال للحصول على تسعير دقيق وفوري.",
  },
  {
    q: "ما أهم سبب لفشل التزريع؟",
    a: "أكثر سبب شائع هو وجود غبار داخل الثقب بسبب تنظيف غير كافٍ، أو التحميل قبل اكتمال التصلب، أو اختيار قطر/عمق غير مناسب.",
  },
  {
    q: "هل توفرون اختبار شد (Pull-out Test)؟",
    a: "نعم يمكن تنفيذ اختبار شد على عينات عند طلب الاستشاري/المشروع للتأكد من كفاءة التثبيت وتحقيق متطلبات الأمان.",
  },
  {
    q: "هل تستخدمون مواد أصلية مثل Hilti أو Fischer؟",
    a: "نعم نوفر مواد حقن معتمدة حسب المتاح والمتطلبات الفنية للمشروع، ويتم اختيارها بناءً على الحمل واتجاه التطبيق وظروف الموقع.",
  },
  {
    q: "هل يمكن تنفيذ التزريع داخل شقة متشطبة؟",
    a: "نعم مع تغطية وحماية للمكان وتقليل الأتربة، والتنفيذ يكون منظم لتقليل الفوضى قدر الإمكان.",
  },
];

// ====== Schema: FAQPage ======
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((x) => ({
    "@type": "Question",
    name: x.q,
    acceptedAnswer: { "@type": "Answer", text: x.a },
  })),
};

// ====== Schema: LocalBusiness ======
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "رواد الخرسانة لقص وتخريم الخرسانة",
  image: LOGO_URL,
  address: {
    "@type": "PostalAddress",
    addressCountry: "EG",
  },
  url: PAGE_URL,
  priceRange: "$$",
};

// ====== Schema: Organization ======
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "رواد الخرسانة لقص وتخريم الخرسانة",
  url: SITE_URL,
  logo: LOGO_URL,
  sameAs: ["https://www.facebook.com/", "https://www.instagram.com/"],
};

// ====== Schema: Service ======
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "تزريع الأشاير الكيميائي وتثبيت الأنكر",
  serviceType: "Rebar Planting / Chemical Anchoring",
  provider: {
    "@type": "LocalBusiness",
    name: "رواد الخرسانة لقص وتخريم الخرسانة",
    url: PAGE_URL,
  },
  areaServed: [{ "@type": "Country", name: "Egypt" }],
  url: PAGE_URL,
};

// ====== Schema: WebPage ======
const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: PAGE_TITLE,
  url: PAGE_URL,
  isPartOf: { "@type": "WebSite", name: "rkhrsana", url: SITE_URL },
};

// ====== Schema: Breadcrumb ======
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "الرئيسية",
      item: `${SITE_URL}/`,
    },
    { "@type": "ListItem", position: 2, name: "تزريع الأشاير", item: PAGE_URL },
  ],
};
---

<Layout
  title={PAGE_TITLE}
  description={PAGE_DESCRIPTION}
  image="/images/og-rebar.webp"
>
  {/* ✅ حقن أكواد Schema في رأس الصفحة */}
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}
  ></script>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(localBusinessSchema)}
  ></script>
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)}
  ></script>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)}
  ></script>
  <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)}
  ></script>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}
  ></script>

  {/* ========================================= */}
  {/* 1) Hero Section */}
  {/* ========================================= */}
  <section
    class="relative bg-slate-900 text-white py-24 lg:py-32 overflow-hidden border-b-4 border-yellow-500"
  >
    <div class="absolute inset-0 bg-slate-800 opacity-90"></div>
    <div
      class="absolute inset-0 bg-[url('/images/rebar-planting/rebar-planting-hero.webp')] bg-cover bg-center mix-blend-overlay opacity-25"
    >
    </div>

    <div class="relative z-10 container mx-auto px-4 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <span
          class="inline-block bg-yellow-500 text-slate-900 font-bold px-4 py-1 rounded-full text-sm md:text-base mb-6 shadow-lg"
        >
          ربط إنشائي قوي + تنفيذ نظيف + أمان عالي في جميع أنحاء مصر
        </span>

        <h1
          class="text-4xl md:text-5xl lg:text-6xl font-extrabold mb-6 leading-tight text-white drop-shadow-lg"
        >
          تزريع الأشاير الكيميائي وتثبيت الأنكر بأمان وبدون عشوائية
        </h1>

        <p
          class="text-lg md:text-2xl mb-10 text-slate-300 leading-relaxed font-light"
        >
          لو محتاج تربط خرسانة قديمة بجديدة، أو تثبت{" "}
          <strong class="text-white font-bold">سيخ تسليح / أنكر بولت</strong>{
            " "
          }
          في خرسانة قائمة—الحل الصح هو{" "}
          <strong class="text-white font-bold">التزريع الكيميائي</strong>{" "}
          بخطوات تنفيذ دقيقة: حفر مضبوط، تنظيف قوي، حقن صحيح، وزمن تصلب قبل التحميل.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/contact"
            class="inline-flex items-center justify-center gap-3 bg-yellow-500 text-slate-900 px-8 py-4 rounded-lg text-xl font-bold hover:bg-yellow-400 hover:scale-105 transition-all shadow-xl shadow-yellow-500/20"
          >
            تواصل معنا واطلب معاينة لمشروعك
          </a>

          <a
            href="#comprehensive-guide"
            class="inline-flex items-center justify-center gap-2 bg-transparent border-2 border-slate-600 text-white px-8 py-4 rounded-lg text-lg font-medium hover:border-yellow-500 hover:text-yellow-500 transition-colors"
          >
            اقرأ الدليل الشامل للخدمة ↓
          </a>
        </div>

        <p class="mt-8 text-sm text-slate-400">
          نغطي جميع محافظات جمهورية مصر العربية ونصل إليك أينما كنت.
        </p>
      </div>
    </div>
  </section>

  {/* ========================================= */}
  {/* 2) مقدمة + جدول تنقل سريع */}
  {/* ========================================= */}
  <section id="comprehensive-guide" class="py-16 bg-white">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="max-w-5xl mx-auto text-right">
        {/* جدول تنقل */}
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 mb-10">
          <div class="flex flex-wrap gap-3 justify-end">
            <a
              href="#uses"
              class="px-4 py-2 rounded-lg bg-white border border-slate-200 hover:border-yellow-500"
            >
              الاستخدامات
            </a>
            <a
              href="#materials"
              class="px-4 py-2 rounded-lg bg-white border border-slate-200 hover:border-yellow-500"
            >
              المواد
            </a>
            <a
              href="#steps"
              class="px-4 py-2 rounded-lg bg-white border border-slate-200 hover:border-yellow-500"
            >
              خطوات التنفيذ
            </a>
            <a
              href="#pricing"
              class="px-4 py-2 rounded-lg bg-white border border-slate-200 hover:border-yellow-500"
            >
              الأسعار
            </a>
            <a
              href="#gallery"
              class="px-4 py-2 rounded-lg bg-white border border-slate-200 hover:border-yellow-500"
            >
              مشاريعنا
            </a>
            <a
              href="#faq"
              class="px-4 py-2 rounded-lg bg-white border border-slate-200 hover:border-yellow-500"
            >
              الأسئلة الشائعة
            </a>
            <a
              href="/contact"
              class="px-4 py-2 rounded-lg bg-yellow-500 font-bold text-slate-900"
            >
              تواصل معنا
            </a>
          </div>
        </div>

        <div class="prose prose-lg prose-slate max-w-none">
          <h2 class="text-3xl font-bold text-slate-900 mb-6">
            الدليل الشامل: ما هو تزريع الأشاير ولماذا هو حل هندسي أساسي؟
          </h2>

          <p class="text-slate-700 leading-loose mb-6">
            في التوسعات الإنشائية، استكمال الأعمدة، عمل سلالم جديدة، ربط كمرات،
            أو تثبيت قواعد معدنية—المشكلة الدائمة هي: كيف ننقل الحمل من الخرسانة
            الجديدة إلى الخرسانة القديمة بأمان؟ هنا يأتي دور{" "}
            <strong>تزريع الأشاير الكيميائي</strong> كحل احترافي يعتمد على تثبيت
            سيخ تسليح داخل الخرسانة القائمة بمادة كيميائية عالية التماسك.
          </p>

          <p class="text-slate-700 leading-loose mb-6">
            الخطأ الأكبر أن البعض يتعامل مع التزريع كأنه “ثقب وخلاص”. أي تنفيذ
            عشوائي بدون تنظيف ممتاز أو اختيار قطر/عمق صحيح أو تحميل مبكر قد يؤدي
            لفشل التزريع. لذلك نحن في "{BRAND}" نلتزم بخطوات تنفيذ دقيقة ومعايير
            سلامة واضحة.
          </p>

          <p class="text-slate-700 leading-loose">
            التزريع (Rebar Planting / Chemical Anchoring) يستخدم مواد معتمدة
            (إيبوكسي/ريزن) لضمان تماسك عالي وتحقيق قدرة تحميل مناسبة حسب الحالة
            والأحمال واتجاه التطبيق.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ========================================= */}
  {/* 3) لماذا التزريع أفضل؟ */}
  {/* ========================================= */}
  <section class="py-20 bg-slate-50 border-t border-slate-200">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">
          لماذا تزريع الأشاير هو الاختيار الأفضل للتدعيم والربط؟
        </h2>
        <div class="w-24 h-1 bg-yellow-500 mx-auto rounded-full mb-6"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-6xl mx-auto">
        {
          [
            {
              n: "1",
              t: "ربط إنشائي قوي بين القديم والجديد",
              p: "يحقق نقل أحمال آمن في حالات التعلية والتوسعات وربط الكمرات والسلالم والقواعد.",
            },
            {
              n: "2",
              t: "بدون تكسير عشوائي أو إضعاف للقطاع",
              p: "التنفيذ الصحيح يعتمد على ثقوب محسوبة وحقن مضبوط، بدل التكسير الذي يسبب شروخ وضعف محيط.",
            },
            {
              n: "3",
              t: "مناسب لتثبيت الأنكر وقواعد الحديد",
              p: "يُستخدم لتثبيت Anchor Bolts وBase Plates والحوامل الثقيلة عند اختيار مادة مناسبة للحمل.",
            },
            {
              n: "4",
              t: "إمكانية اختبار شد للتأكيد",
              p: "عند طلب الاستشاري يمكن عمل Pull-out Test لزيادة الثقة وتوثيق الجودة بالموقع.",
            },
          ].map((x) => (
            <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100 flex flex-col md:flex-row gap-6 hover:shadow-md transition-shadow">
              <div class="w-16 h-16 shrink-0 bg-slate-900 text-yellow-500 rounded-2xl flex items-center justify-center text-3xl font-black">
                {x.n}
              </div>
              <div>
                <h3 class="text-2xl font-bold text-slate-800 mb-3">{x.t}</h3>
                <p class="text-slate-600 leading-relaxed">{x.p}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ========================================= */}
  {/* 4) الاستخدامات (ID: uses) */}
  {/* ========================================= */}
  <section id="uses" class="py-20 bg-white">
    <div class="container mx-auto px-4 lg:px-8 max-w-6xl">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-5xl font-bold text-slate-900 mb-6">
          أهم استخدامات تزريع الأشاير
        </h2>
        <p class="text-lg text-slate-600 max-w-3xl mx-auto">
          نقدم في "{BRAND}" كل أعمال التزريع الكيميائي للحديد والأنكر حسب
          متطلبات الموقع والأحمال.
        </p>
      </div>

      <div class="space-y-12">
        <div
          class="flex flex-col md:flex-row gap-8 items-center bg-slate-50 rounded-2xl overflow-hidden border border-slate-100"
        >
          <div class="w-full md:w-1/3 h-64 bg-slate-200 relative">
            <img
              src="/images/rebar-planting/rebar-planting-1.webp"
              alt="تزريع أشاير لاستكمال الأعمدة والتعلية"
              class="object-cover w-full h-full"
              loading="lazy"
            />
          </div>
          <div class="w-full md:w-2/3 p-6 md:p-8">
            <h3 class="text-2xl font-bold text-slate-900 mb-4">
              استكمال الأعمدة والتعلية وربط الخرسانة القديمة بالجديدة
            </h3>
            <ul class="space-y-2 text-slate-700 list-disc list-inside mb-4">
              <li>تزريع أشاير لتعلية أعمدة وإضافة دور جديد.</li>
              <li>ربط كمرات جديدة بكمرات قديمة بأمان.</li>
              <li>توسعة بلاطات وبلكونات خرسانية.</li>
            </ul>
            <p class="text-slate-600 text-sm">
              التنفيذ يكون بأقطار وعمق مدروسين حسب قطر السيخ ومتطلبات التحميل.
            </p>
          </div>
        </div>

        <div
          class="flex flex-col md:flex-row-reverse gap-8 items-center bg-slate-50 rounded-2xl overflow-hidden border border-slate-100"
        >
          <div class="w-full md:w-1/3 h-64 bg-slate-200 relative">
            <img
              src="/images/rebar-planting/rebar-planting-2.webp"
              alt="تزريع أشاير للسلالم وربطها بالخرسانة"
              class="object-cover w-full h-full"
              loading="lazy"
            />
          </div>
          <div class="w-full md:w-2/3 p-6 md:p-8">
            <h3 class="text-2xl font-bold text-slate-900 mb-4">
              تزريع أشاير السلالم وربط الحوائط الساندة
            </h3>
            <p class="text-slate-700 leading-relaxed mb-4">
              في إنشاء سلالم جديدة أو تعديل مسار سلم قديم، التزريع يضمن ربط قوي
              داخل العناصر القائمة بدون تكسير عشوائي، مع مراعاة العمق والقطر
              والتنظيف وزمن التصلب.
            </p>
          </div>
        </div>

        <div
          class="flex flex-col md:flex-row gap-8 items-center bg-slate-50 rounded-2xl overflow-hidden border border-slate-100"
        >
          <div class="w-full md:w-1/3 h-64 bg-slate-200 relative">
            <img
              src="/images/rebar-planting/rebar-planting-3.webp"
              alt="تثبيت أنكر كيميائي"
              class="object-cover w-full h-full"
              loading="lazy"
            />
          </div>
          <div class="w-full md:w-2/3 p-6 md:p-8">
            <h3 class="text-2xl font-bold text-slate-900 mb-4">
              تثبيت الأنكر الكيميائي (Anchor Bolts) وقواعد الحديد
            </h3>
            <ul class="space-y-2 text-slate-700 list-disc list-inside mb-4">
              <li>تثبيت Base Plates وقواعد أعمدة معدنية.</li>
              <li>تثبيت حوامل ومعدات وأحمال ثقيلة.</li>
              <li>تثبيت درابزين وحواجز عند الحاجة.</li>
            </ul>
            <p class="text-slate-600 text-sm">
              اختيار المادة يتحدد حسب الحمل واتجاه التطبيق وظروف الخرسانة.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ========================================= */}
  {/* 4.5) قسم ثقة/سلامة (E-E-A-T) */}
  {/* ========================================= */}
  <section class="py-16 bg-white border-t border-slate-100">
    <div class="container mx-auto px-4 lg:px-8 max-w-6xl">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">
          ما الذي يميز تنفيذ التزريع عندنا؟
        </h2>
        <p class="text-slate-600 max-w-3xl mx-auto">
          لأن التزريع مش مادة “حلوة” وخلاص… ده نظام تنفيذ يحدد قوة الربط ودرجة
          الأمان على المدى الطويل.
        </p>
      </div>


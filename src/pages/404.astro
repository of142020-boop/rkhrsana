---
// src/pages/404.astro
import Layout from "../layouts/Layout.astro";

const TITLE = "الصفحة غير موجودة | رواد الخرسانة";
const DESCRIPTION =
    "نعتذر، الصفحة التي تبحث عنها غير موجودة في موقع رواد الخرسانة لقص وتخريم الخرسانة.";
---

<Layout title={TITLE} description={DESCRIPTION}>
    <section
        class="min-h-[70vh] flex flex-col items-center justify-center bg-slate-900 text-white relative overflow-hidden py-20 px-4 text-center"
    >
        {/* الخلفية */}
        <div class="absolute inset-0 bg-slate-800 opacity-90 z-0"></div>
        <div
            class="absolute inset-0 bg-[url('/images/og-default.webp')] bg-cover bg-center mix-blend-overlay opacity-20 z-0"
        >
        </div>

        <div class="relative z-10 max-w-2xl mx-auto">
            {/* 404 رقم */}
            <div class="mb-8">
                <h1
                    class="text-8xl md:text-9xl font-black text-transparent bg-clip-text bg-gradient-to-br from-yellow-400 to-yellow-600 drop-shadow-2xl"
                >
                    404
                </h1>
            </div>

            <h2 class="text-3xl md:text-4xl font-bold mb-6">
                عفواً، الصفحة التي تبحث عنها غير موجودة!
            </h2>

            <p
                class="text-lg md:text-xl text-slate-300 mb-10 leading-relaxed max-w-xl mx-auto"
            >
                يبدو أن الرابط الذي اتبعته خاطئ أو تم تغيير مكان الصفحة. لا
                تقلق، يمكنك العودة واكتشاف خدماتنا بكل سهولة.
            </p>

            {/* الروابط */}
            <div
                class="flex flex-col sm:flex-row gap-4 justify-center items-center"
            >
                <a
                    href="/"
                    class="inline-flex items-center justify-center w-full sm:w-auto gap-2 bg-yellow-500 text-slate-900 px-8 py-4 rounded-xl text-lg font-bold hover:bg-yellow-400 transition-colors shadow-lg shadow-yellow-500/20"
                >
                    <svg
                        class="w-6 h-6"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
                        ></path>
                    </svg>
                    العودة للرئيسية
                </a>

                <a
                    href="/contact"
                    class="inline-flex items-center justify-center w-full sm:w-auto gap-2 bg-transparent border-2 border-slate-600 text-white px-8 py-4 rounded-xl text-lg font-bold hover:border-yellow-500 hover:text-yellow-500 transition-colors"
                >
                    <svg
                        class="w-6 h-6"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                        ></path>
                    </svg>
                    تواصل معنا
                </a>
            </div>
        </div>
    </section>
</Layout>

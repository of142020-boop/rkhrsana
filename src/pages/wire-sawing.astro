---
// src/pages/wire-saw.astro
import Layout from "../layouts/Layout.astro";

/**
 * ✅ صفحة "قص الخرسانة بالواير" محسّنة:
 * - Schema قوي: FAQ + LocalBusiness + Organization + Service + WebPage + Breadcrumb
 * - FAQ موحّد (UI + Schema)
 * - جدول تنقل سريع + IDs للأقسام (services/equipment/pricing/gallery/faq)
 * - E-E-A-T + Gallery
 * - إزالة نماذج التسعير وأزرار الواتساب/الاتصال والاعتماد على التوجيه لصفحة التواصل ✅
 * - تغطية جغرافية شاملة لجميع أنحاء مصر ✅
 * - Meta Title احترافي مدمج به الكلمة المفتاحية ورقم الهاتف (SEO + CTR) ✅
 */

// ====== بيانات أساسية ======
const BRAND = "رواد الخرسانة";
const PHONE = "01070046464"; // مخصص للميتا تايتل فقط
const SITE_URL = "https://rkhrsana.com";
const PAGE_URL = `${SITE_URL}/wire-saw`;
const LOGO_URL = `${SITE_URL}/logo.png`;

// ====== SEO ======
const PAGE_TITLE = `واير تقطيع خرسانة | قص الخرسانة بالواير الماسي | اتصل ${PHONE}`;
const PAGE_DESCRIPTION = `خدمة واير تقطيع خرسانة (Diamond Wire Saw) لقص الخرسانة المسلحة والكمرات والأعمدة والقواعد والخوازيق بدقة عالية وبدون اهتزاز. نصلك في أي مكان في مصر.`;

// ====== FAQ موحّد: يظهر في الصفحة + Schema ======
const faqItems = [
  {
    q: "ما هي خدمة واير تقطيع خرسانة (Diamond Wire Saw)؟",
    a: "واير تقطيع خرسانة هو نظام قص احترافي يستخدم سلك ماسي (Diamond Wire) يدور حول الخرسانة لقصها بدقة عالية. مناسب للكتل الكبيرة والسمكات الضخمة وقص الخرسانة المسلحة بدون تكسير وبدون اهتزاز تقريبًا."
  },
  {
    q: "متى نستخدم قص الخرسانة بالواير بدل منشار الحائط أو الصاروخ؟",
    a: "نستخدم القص بالواير عند الحاجة لقص أعماق كبيرة جدًا أو قص قواعد ولبشات وكمرات ضخمة أو إزالة كتلة خرسانية كبيرة أو في مواقع لا تسمح بالمنشار الجداري بسهولة."
  },
  {
    q: "هل قص الخرسانة بالواير يسبب شروخ أو تأثير إنشائي؟",
    a: "عند التنفيذ بواسطة مقاول قص خرسانة محترف ووفق تعليمات المهندس الإنشائي، فإن الواير الماسي يعمل بدون اهتزاز تقريبًا مما يقلل مخاطر الشروخ مقارنة بالتكسير التقليدي."
  },
  {
    q: "كيف يتم حساب اسعار قص الخرسانة بالواير؟",
    a: "اسعار قص الخرسانة بالواير تعتمد على السمك وطول مسار القص بالمتر وكثافة الحديد داخل الخرسانة المسلحة وصعوبة الموقع والارتفاعات ونوع التشغيل (مياه/شفط). للتسعير الدقيق يرجى التواصل معنا."
  },
  {
    q: "هل يمكن قص الكمرات والأعمدة والخوازيق بالواير؟",
    a: "نعم. منشار واير خرسانة مناسب جدًا لأعمال قص الكمرات بالواير وقص الأعمدة بالواير وقص الخوازيق والقواعد الخرسانية واللبشة المسلحة بدقة وبأقل ضوضاء ممكنة."
  },
  {
    q: "هل لازم مياه أثناء التشغيل؟",
    a: "غالبًا يتم استخدام مياه للتبريد وتقليل الحرارة وإطالة عمر الواير، لكن طريقة التشغيل تتحدد حسب الموقع وظروفه وإمكانية الشفط وتقليل الفوضى."
  },
  {
    q: "هل يمكن دمج الكور مع الواير؟",
    a: "نعم. أحيانًا نعمل فتحات كور لتجهيز نقاط بداية/مسار ثم يتم القص بالواير للمساحات أو الأعماق الأكبر."
  },
  {
    q: "هل توفرون إزالة ونقل الكتل بعد القص؟",
    a: "متاح حسب الاتفاق وظروف الموقع، ويمكن توفير فصل/تقطيع الكتلة إلى أجزاء لتسهيل الرفع والنقل."
  }
];

// ====== Schema: FAQPage ======
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((x) => ({
    "@type": "Question",
    "name": x.q,
    "acceptedAnswer": { "@type": "Answer", "text": x.a }
  }))
};

// ====== Schema: LocalBusiness ======
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "رواد الخرسانة لقص وتخريم الخرسانة",
  "image": LOGO_URL,
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "EG"
  },
  "url": PAGE_URL,
  "priceRange": "$$"
};

// ====== Schema: Organization ======
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "رواد الخرسانة لقص وتخريم الخرسانة",
  "url": SITE_URL,
  "logo": LOGO_URL,
  "sameAs": [
    "https://www.facebook.com/",
    "https://www.instagram.com/"
  ]
};

// ====== Schema: Service ======
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "واير تقطيع خرسانة (قص الخرسانة بالواير الماسي)",
  "serviceType": "Concrete Cutting - Diamond Wire Saw",
  "provider": {
    "@type": "LocalBusiness",
    "name": "رواد الخرسانة لقص وتخريم الخرسانة",
    "url": PAGE_URL
  },
  "areaServed": [
    { "@type": "Country", "name": "Egypt" }
  ],
  "url": PAGE_URL,
  "description": PAGE_DESCRIPTION
};

// ====== Schema: WebPage ======
const webPageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": PAGE_TITLE,
  "url": PAGE_URL,
  "isPartOf": { "@type": "WebSite", "name": "rkhrsana", "url": SITE_URL }
};

// ====== Schema: Breadcrumb ======
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "الرئيسية", "item": `${SITE_URL}/` },
    { "@type": "ListItem", "position": 2, "name": "واير تقطيع خرسانة", "item": PAGE_URL }
  ]
};
---

<Layout title={PAGE_TITLE} description={PAGE_DESCRIPTION}>
  {/* ✅ Canonical */}
  <link rel="canonical" href={PAGE_URL} />

  {/* ✅ Schema JSON-LD */}
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  {/* ========================================= */}
  {/* 1) Hero Section */}
  {/* ========================================= */}
  <section class="relative bg-slate-900 text-white py-24 lg:py-32 overflow-hidden border-b-4 border-yellow-500">
    <div class="absolute inset-0 bg-slate-800 opacity-90"></div>
    <div class="absolute inset-0 bg-[url('https://placehold.co/1920x1080/0f172a/0f172a?text=Diamond+Wire+Saw')] bg-cover bg-center mix-blend-overlay opacity-25"></div>

    <div class="relative z-10 container mx-auto px-4 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <span class="inline-block bg-yellow-500 text-slate-900 font-bold px-4 py-1 rounded-full text-sm md:text-base mb-6 shadow-lg">
          قص ضخم بدون تكسير وبدون اهتزاز تقريبًا في جميع أنحاء مصر
        </span>

        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold mb-6 leading-tight text-white drop-shadow-lg">
          واير تقطيع خرسانة — قص الخرسانة بالواير الماسي بدقة عالية
        </h1>

        <p class="text-lg md:text-2xl mb-10 text-slate-300 leading-relaxed font-light">
          لو عندك كتلة خرسانية كبيرة، قاعدة/لبشة، كمرة ضخمة، أو خوازيق — خدمة{" "}
          <strong class="text-white font-bold">قص الخرسانة بالواير</strong>{" "}
          هي الحل الأقوى لأن{" "}
          <strong class="text-white font-bold">Diamond Wire Saw</strong>{" "}
          يقطع بدون تكسير عشوائي وبأقل اهتزاز ممكن.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/contact"
            class="inline-flex items-center justify-center gap-3 bg-yellow-500 text-slate-900 px-8 py-4 rounded-lg text-xl font-bold hover:bg-yellow-400 hover:scale-105 transition-all shadow-xl shadow-yellow-500/20"
          >
            تواصل معنا واطلب تسعير لمشروعك
          </a>

          <a
            href="#comprehensive-guide"
            class="inline-flex items-center justify-center gap-2 bg-transparent border-2 border-slate-600 text-white px-8 py-4 rounded-lg text-lg font-medium hover:border-yellow-500 hover:text-yellow-500 transition-colors"
          >
            اقرأ الدليل الشامل للخدمة ↓
          </a>
        </div>

        <p class="mt-8 text-sm text-slate-400">
          نغطي جميع محافظات جمهورية مصر العربية ونصل إليك أينما كنت.
        </p>
      </div>
    </div>
  </section>

  {/* ========================================= */}
  {/* 2) مقدمة + جدول تنقل سريع */}
  {/* ========================================= */}
  <section id="comprehensive-guide" class="py-16 bg-white">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="max-w-5xl mx-auto text-right">
        {/* جدول تنقل */}
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-4 mb-10">
          <div class="flex flex-wrap gap-3 justify-end">
            <a href="#services" class="px-4 py-2 rounded-lg bg-white border border-slate-200 hover:border-yellow-500">
              الخدمات
            </a>
            <a href="#equipment" class="px-4 py-2 rounded-lg bg-white border border-slate-200 hover:border-yellow-500">
              المعدات
            </a>
            <a href="#pricing" class="px-4 py-2 rounded-lg bg-white border border-slate-200 hover:border-yellow-500">
              الأسعار
            </a>
            <a href="#gallery" class="px-4 py-2 rounded-lg bg-white border border-slate-200 hover:border-yellow-500">
              مشاريعنا
            </a>
            <a href="#faq" class="px-4 py-2 rounded-lg bg-white border border-slate-200 hover:border-yellow-500">
              الأسئلة الشائعة
            </a>
            <a href="/contact" class="px-4 py-2 rounded-lg bg-yellow-500 font-bold text-slate-900">
              تواصل معنا
            </a>
          </div>
        </div>

        <div class="prose prose-lg prose-slate max-w-none">
          <h2 class="text-3xl font-bold text-slate-900 mb-6">
            الدليل الشامل: ما هو قص الخرسانة بالواير ولماذا هو الأقوى في الأعمال الضخمة؟
          </h2>

          <p class="text-slate-700 leading-loose mb-6">
            كثير من المشاريع تواجه مواقف “قص عميق” أو “كتلة خرسانية كبيرة” لا تناسبها حلول الصاروخ أو المنشار الجداري.
            هنا يأتي دور{" "}
            <strong class="text-yellow-600">واير تقطيع خرسانة</strong>{" "}
            أو <strong class="text-slate-900">Diamond Wire Saw</strong>:
            نظام يعتمد على سلك ماسي يدور حول الخرسانة ويقوم بالقص الأسطواني/المساري بدقة عالية.
          </p>

          <p class="text-slate-700 leading-loose mb-6">
            أهم ميزة أن{" "}
            <strong class="text-slate-900">قص الخرسانة بالواير</strong>{" "}
            يقلل الاهتزازات بشكل كبير مقارنة بالتكسير، لذلك يُستخدم بكثرة في:
            القواعد، اللبشات، الخوازيق، الكمرات الضخمة، الأعمدة، وأعمال البنية التحتية.
          </p>

          <p class="text-slate-700 leading-loose">
            نحن في "{BRAND}" ننفذ القص بخطة تشغيل واضحة: تحديد المسار، تثبيت البكرات والشدّاد، تبريد مناسب، وتسليم حواف
            نظيفة تقلل أعمال الترميم بعد القص.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ========================================= */}
  {/* 3) لماذا الواير أفضل؟ */}
  {/* ========================================= */}
  <section class="py-20 bg-slate-50 border-t border-slate-200">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-6">
          لماذا قص الخرسانة بالواير أفضل من التكسير أو الحلول المحدودة؟
        </h2>
        <div class="w-24 h-1 bg-yellow-500 mx-auto rounded-full mb-6"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-6xl mx-auto">
        {[
          {
            n: "1",
            t: "قدرة على قص أعماق وسمكات ضخمة",
            p: "مناسب للقواعد واللبشات والكتل الكبيرة والكبارى حيث يصعب القص بالمنشار الجداري أو يصبح غير اقتصادي."
          },
          {
            n: "2",
            t: "يقطع الخرسانة والحديد معًا",
            p: "السلك الماسي (Diamond Wire) مصمم للتعامل مع كثافات الحديد داخل الخرسانة المسلحة بدون تكسير عشوائي."
          },
          {
            n: "3",
            t: "اهتزاز أقل = أمان إنشائي أعلى",
            p: "القص بالواير يعتمد على القطع وليس الطرق، لذلك يقلل الشروخ الدقيقة ويحافظ على العناصر المجاورة."
          },
          {
            n: "4",
            t: "دقة أفضل في المسارات المعقدة",
            p: "يمكن ضبط مسار القص والتحكم به للحصول على نتائج نظيفة في أعمال مثل قص الخوازيق أو فصل كتل خرسانية."
          }
        ].map((x) => (
          <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100 flex flex-col md:flex-row gap-6 hover:shadow-md transition-shadow">
            <div class="w-16 h-16 shrink-0 bg-slate-900 text-yellow-500 rounded-2xl flex items-center justify-center text-3xl font-black">
              {x.n}
            </div>
            <div>
              <h3 class="text-2xl font-bold text-slate-800 mb-3">{x.t}</h3>
              <p class="text-slate-600 leading-relaxed">{x.p}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ========================================= */}
  {/* 4) خدماتنا الأساسية (ID: services) */}
  {/* ========================================= */}
  <section id="services" class="py-20 bg-white">
    <div class="container mx-auto px-4 lg:px-8 max-w-6xl">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-5xl font-bold text-slate-900 mb-6">خدماتنا الأساسية في واير تقطيع خرسانة</h2>
        <p class="text-lg text-slate-600 max-w-3xl mx-auto">
          نقدم في "{BRAND}" كل أعمال <strong>قص الخرسانة بالواير الماسي</strong> للمشاريع الثقيلة بدقة واحتراف.
        </p>
      </div>

      <div class="space-y-12">
        <div class="flex flex-col md:flex-row gap-8 items-center bg-slate-50 rounded-2xl overflow-hidden border border-slate-100">
          <div class="w-full md:w-1/3 h-64 bg-slate-200 relative">
            <img
              src="https://placehold.co/900x600/0f172a/f59e0b?text=Footings+Raft+Wire+Saw"
              alt="قص القواعد واللبشات بالواير"
              class="object-cover w-full h-full"
              loading="lazy"
            />
          </div>
          <div class="w-full md:w-2/3 p-6 md:p-8 text-right">
            <h3 class="text-2xl font-bold text-slate-900 mb-4">قص القواعد واللبشات والكتل الكبيرة</h3>
            <ul class="space-y-2 text-slate-700 list-disc list-inside mb-4">
              <li>قص قواعد خرسانية سميكة ولبشات مسلحة.</li>
              <li>فصل كتل خرسانية كبيرة لتسهيل الرفع والنقل.</li>
              <li>حل مثالي للمشاريع الصناعية والبنية التحتية.</li>
            </ul>
            <p class="text-slate-600 text-sm">تجهيز مسار القص وتثبيت البكرات/الشدّاد يضمن نتيجة مستقيمة ونظيفة.</p>
          </div>
        </div>

        <div class="flex flex-col md:flex-row-reverse gap-8 items-center bg-slate-50 rounded-2xl overflow-hidden border border-slate-100">
          <div class="w-full md:w-1/3 h-64 bg-slate-200 relative">
            <img
              src="https://placehold.co/900x600/0f172a/f59e0b?text=Beams+Columns+Wire+Saw"
              alt="قص الكمرات والأعمدة بالواير"
              class="object-cover w-full h-full"
              loading="lazy"
            />
          </div>
          <div class="w-full md:w-2/3 p-6 md:p-8 text-right">
            <h3 class="text-2xl font-bold text-slate-900 mb-4">قص الكمرات والأعمدة (تعديلات إنشائية محسوبة)</h3>
            <p class="text-slate-700 leading-relaxed mb-4">
              قص الكمرات والأعمدة بالواير مناسب عندما تكون الدقة وتقليل الاهتزاز أولوية. التنفيذ يكون بعد تحديد المسار
              ومراعاة متطلبات السلامة والتعليمات الإنشائية للموقع.
            </p>
          </div>
        </div>

        <div class="flex flex-col md:flex-row gap-8 items-center bg-slate-50 rounded-2xl overflow-hidden border border-slate-100">
          <div class="w-full md:w-1/3 h-64 bg-slate-200 relative">
            <img
              src="https://placehold.co/900x600/0f172a/f59e0b?text=Piles+Infrastructure+Wire+Saw"
              alt="قص الخوازيق بالواير"
              class="object-cover w-full h-full"
              loading="lazy"
            />
          </div>
          <div class="w-full md:w-2/3 p-6 md:p-8 text-right">
            <h3 class="text-2xl font-bold text-slate-900 mb-4">قص الخوازيق وأعمال البنية التحتية</h3>
            <p class="text-slate-700 leading-relaxed mb-4">
              منشار واير خرسانة مناسب جدًا لقص الخوازيق والقواعد والقطاعات الضخمة في مشاريع الكباري والطرق والمرافق، مع
              تحكم أفضل في الضوضاء والتأثير على العناصر القريبة.
            </p>
          </div>
        </div>

        <div class="flex flex-col md:flex-row gap-8 items-center bg-yellow-50 rounded-2xl overflow-hidden border-2 border-yellow-400 shadow-md">
          <div class="w-full md:w-1/3 h-64 bg-slate-200 relative">
            <img
              src="https://placehold.co/900x600/0f172a/f59e0b?text=Wire+Saw+Site+Safety"
              alt="سلامة قص الخرسانة بالواير"
              class="object-cover w-full h-full"
              loading="lazy"
            />
          </div>
          <div class="w-full md:w-2/3 p-6 md:p-8 text-right">
            <h3 class="text-2xl font-bold text-red-700 mb-4 flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              السلامة أولاً (تنفيذ خاضع لدراسة الموقع)
            </h3>

            <p class="text-slate-800 leading-relaxed mb-4 font-medium">
              القص بالواير يتطلب تجهيز وتثبيت صحيح للبكرات والشداد، وتأمين مسار الكتلة بعد الفصل، ومراعاة متطلبات السلامة

---
// src/layouts/Layout.astro
import "../styles/global.css";

// 1. إضافة متغير image مع صورة افتراضية
const { title, description, image = "/images/og-default.webp" } = Astro.props;

// تأكد من أن رابط الصورة هو رابط مطلق (Absolute URL) يدعم تغيير الدومين
const siteUrl = Astro.site ? new URL(Astro.site).origin : Astro.url.origin;
const ogImage = image.startsWith("http")
  ? image
  : `${siteUrl}${image.startsWith("/") ? "" : "/"}${image}`;

// 2. الحصول على مسار الصفحة الحالية ومعالجته لضمان الدقة
const currentPath = Astro.url.pathname;
const normalizedPath =
  currentPath.endsWith("/") && currentPath.length > 1
    ? currentPath.slice(0, -1)
    : currentPath;
---

<!DOCTYPE html>
<html lang="ar" dir="rtl" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/webp" href="/images/logo.webp" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href={Astro.url.href.replace(/\/$/, "")} />

    <!-- Preconnect & Preload -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="image" href="/images/logo.webp" />

    <title>{title} | رواد الخرسانة</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta
      name="keywords"
      content="قص خرسانة, تخريم كور, قص بالمنشار, قص بالواير, تزريع أشاير, مدينة نصر, القاهرة, مصر, رواد الخرسانة"
    />

    <meta property="og:title" content={`${title} | رواد الخرسانة`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | رواد الخرسانة`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- LocalBusiness Schema -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "رواد الخرسانة",
        "image": "https://rkhrsana.com/images/og-default.webp",
        "url": "https://rkhrsana.com/",
        "telephone": "+201070046464",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "القاهرة",
          "addressCountry": "EG"
        },
        "description": "شركة رائدة في مجال قص وتخريم الخرسانة بالكور والمنشار والواير، وتزريع الأشاير الكيميائية بأحدث المعدات الألمانية بدون تكسير عشوائي في مصر.",
        "areaServed": {
          "@type": "Country",
          "name": "مصر"
        }
      }
    </script>
  </head>

